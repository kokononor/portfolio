---
// Swad case study. Figma: "Swad — Case Study" (362:500), 1728 × 28466, page fill #fcfbf8.
// The body is generated from the frame's design context by tools/figma-jsx-to-astro.mjs (exact Figma values, scaled
// by var(--u)); regenerate it after design changes with:
//   node tools/figma-jsx-to-astro.mjs design/swad-362-500.jsx design/swad-body.html --cut-from 27895 --asset-url /work/swad/
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import NextProject from '../../components/NextProject.astro';
import body from '../../../design/swad-body.html?raw';

// the photos from Figma, placed in their slots by layer name (the delivery-apps and regulars slots are still placeholders there)
const PHOTOS: Record<string, [string, string]> = {
  "Hero photo (placeholder)": ['hero', 'The Swad counter seen through its open shopfront'],
  "Image: Swad's lane, Ranchi": ['lane', "Swad's quiet residential lane in Ranchi"],
  'Image: Swad before the relaunch': ['before-relaunch', 'The Swad shopfront before the relaunch, with a Momos banner'],
  'Image: Outside Swad, during an observation session': ['outside', 'The lane outside Swad during an observation session'],
  'Image: Old menu against new menu': ['menus', 'The old and new Swad menu prices side by side'],
  'Image: All five plates, mild to hot': ['plates', 'Five plates of momos, from mild to hot'],
  'Image: The five blends': ['blends', 'Jars of the Delhi, Lucknow and Hyderabad momo masalas'],
  'Image: The procedures binder': ['binder', 'A printed recipe sheet beside a mint mojito'],
  'Image: Storefront, before': ['store-before', 'The storefront before the relaunch'],
  'Image: Storefront, after': ['store-after', 'The storefront after the relaunch, with a dark Swad counter'],
  'Image: The new interior': ['interior', 'Shelving being built for the new interior'],
  'Image: The nine-item menu': ['menu', 'A corner of the kitchen during the rebuild'],
};
const withPhotos = (src: string) => Object.entries(PHOTOS).reduce((out, [name, [file, alt]]) => {
  const attr = `data-name="${name}"`;
  const at = out.indexOf(attr);
  if (at < 0) return out;
  const close = out.indexOf('>', at);
  const start = out.lastIndexOf('<div', at);
  const open = out.slice(start, close + 1).replace(/; border: 1px dashed #0f0e0c/, '');
  // the slot's own end, so its placeholder labels ("IMAGE PLACEHOLDER", the shot description) can go: the photo
  // covers them, but screen readers would still read them out
  let depth = 0, end = start;
  const tags = /<div[\s>]|<\/div>/g;
  tags.lastIndex = start;
  for (let m; (m = tags.exec(out)); ) { depth += m[0] === '</div>' ? -1 : 1; if (!depth) { end = tags.lastIndex; break; } }
  const inside = out.slice(close + 1, end).replace(/<p [^>]*>.*?<\/p>/gs, '');
  return out.slice(0, start) + open + `<img class="swad-photo" src="/work/swad/photos/${file}.webp" alt="${alt}" loading="lazy" />` + inside + out.slice(end);
}, src);
// real headings for the generated body: the title is the page's h1, the numbered section titles are h2s
const withHeadings = (src: string) => src
  .replace(/<p (style="[^"]*")>(<span[^>]*>Swad:<\/span>.*?)<\/p>/s, '<h1 $1>$2</h1>')
  .replace(/<p (style="[^"]*font-size: calc\(49 \* var\(--u\)\); color: #681609[^"]*")>(.*?)<\/p>/g,
    (_, style: string, text: string) => style.includes('white-space: nowrap')
      ? `<h2 ${style}>${text}</h2>`         // the numbered section titles sit on one line
      : `<h3 ${style}>${text}</h3>`);       // callouts and the closing lessons in the same face

// The 12-column grid, on the 1728 design: margins 104, gutters 64, columns 68. The generated body sits on 24px gutters
// (with section 02 off the margin), so its offsets and spans are mapped to the grid here, which also
// survives regenerating the body. Offsets are inside the 1520 content box; spans are 3, 6 and 9 columns.
const GRID_LEFT: Record<string, string> = { '386': '396', '772': '792', '1158': '1188' };
const GRID_WIDTH: Record<string, string> = {
  '362': '332', '748': '728', '1134': '1124', // 3, 6 and 9 columns
  '852': '832',                               // the hero photo: bleeds in from the left to the end of column 6
  '722': '702', '650': '630', '652': '632', '620': '600', // text inset inside a span keeps its inset
  '338': '310', '194': '178', '164': '150',   // comparison bars, in proportion to their 3-column track
};
const toGrid = (src: string) => src.replace(/<(?:div|p)\b[^>]*>/g, tag => tag
  .replace(/left: calc\((116|49) \* var\(--u\)\)(?=[^>]*width: calc\(1520 \*)/, 'left: calc(104 * var(--u))')
  .replace(/left: calc\((386|772|1158) \* var/, (_, v) => `left: calc(${GRID_LEFT[v]} * var`)
  .replace(/left: calc\(50% \+ 12 \* var/, 'left: calc(50% + 32 * var')
  .replace(/left: calc\(75% - 34 \* var/, 'left: calc(75% - 4 * var')
  .replace(/left: calc\(91\.67% \+ 6\.5 \* var/, 'left: calc(91.67% + 27.5 * var')
  .replace(/left: calc\(91\.67% - 5\.5 \* var/, 'left: calc(91.67% + 15.5 * var')
  .replace(/(^|[ ;"])width: calc\((\d+) \* var/, (m, pre, v) => GRID_WIDTH[v] ? `${pre}width: calc(${GRID_WIDTH[v]} * var` : m));

// the nav: brand and resume become links
const html = withHeadings(withPhotos(toGrid(body)))
  .replace(/<p [^>]*>Hero photo: Swad storefront<\/p>/, '')
  .replace(/<p [^>]*>SUYASH <\/p>/, '')
  .replace(/<p [^>]*>RESUME<\/p>\s*<div [^>]*data-name="Vector">.*?<\/div><\/div>/, '');
---
<Base title="Swad: How a Momo Café That Couldn't Make Rent Found Its Regulars · Suyash" description="A quiet-lane café in Ranchi went from losing ₹10,000 a month to ₹20,000 in profit in six months.">
  <Nav solid />
  <main class="canvas swad-canvas" style="height: calc(27895 * var(--u));" set:html={html}></main>
  <NextProject href="/work/diviniti" label="DIVINITI" title="Redefining Design" />
  <Footer />
</Base>

<script>
  // Motion, in the same vocabulary as the other case studies (scripts/case-motion.ts). This body is generated from
  // Figma, so the blocks are tagged here rather than in the markup: images wipe open from their
  // side, and every block of text slides in from its side. Numbered sections are tagged block by block.
  const canvas = document.querySelector<HTMLElement>('.swad-canvas');
  if (canvas) {
    const width = canvas.getBoundingClientRect().width;
    const tag = (el: HTMLElement) => {
      if (el.tagName === 'A' || el.dataset.name === 'Vector') return;
      const side = el.getBoundingClientRect().left - canvas.getBoundingClientRect().left > width * 0.4 ? 'right' : 'left';
      if (/^Image|placeholder/i.test(el.dataset.name || '')) el.dataset.wipe = side;
      else el.dataset.slide = side;
    };
    for (const block of canvas.children as HTMLCollectionOf<HTMLElement>) {
      if (/^\d\d /.test(block.dataset.name || '')) [...(block.children as HTMLCollectionOf<HTMLElement>)].forEach(tag);
      else tag(block);
    }
  }

  // Text never drops below a readable size, so on desktop windows (mostly 901–1365px) a paragraph can grow taller
  // than its Figma slot and run into the block below. Working from the innermost frames out, each block that text
  // runs into moves down (with everything after it in its frame), and a frame grows when its content outgrew it.
  // Where nothing collides nothing moves; phones use their own stacked layout.
  if (canvas) {
    const desk = matchMedia('(min-width: 901px)');
    const abs = (el: Element) => [...el.children].filter((c): c is HTMLElement => getComputedStyle(c).position === 'absolute');
    const reset = () => {
      canvas.querySelectorAll<HTMLElement>('[data-settled]').forEach(e => {
        e.style.marginTop = '';
        if (e.dataset.h0) e.style.height = e.dataset.h0;
        delete e.dataset.settled;
      });
      if (canvas.dataset.h0) canvas.style.height = canvas.dataset.h0;
    };
    // how far down a block's text reaches (a frame may be drawn taller or shorter than what is in it)
    const inkBottom = (e: HTMLElement): number => {
      const kids = abs(e);
      if (!kids.length) return e.textContent?.trim() ? e.offsetHeight : 0;
      return Math.max(0, ...kids.map(c => { const b = inkBottom(c); return b ? c.offsetTop + b : 0; }));
    };
    // where a block's content starts (its text or pictures; a frame's top edge may be empty space)
    const inkTop = (e: HTMLElement): number => {
      const kids = abs(e);
      if (!kids.length) return e.textContent?.trim() || e.querySelector('img') || e.tagName === 'IMG' ? 0 : Infinity;
      return Math.min(Infinity, ...kids.map(c => c.offsetTop + inkTop(c)));
    };
    const settle = (box: HTMLElement): number => {
      const kids = abs(box);
      kids.forEach(k => { if (abs(k).length) settle(k); });
      const it = kids.map(e => ({ e, top: e.offsetTop, h: e.offsetHeight, ink: inkBottom(e), lead: inkTop(e), l: e.offsetLeft, w: e.offsetWidth, text: !!e.textContent?.trim(), shift: 0 }))
        .sort((a, b) => a.top - b.top);
      for (let i = 0; i < it.length; i++) {
        const a = it[i];
        if (!a.text) continue;
        for (let j = i + 1; j < it.length; j++) {
          const b = it[j];
          if (b.top <= a.top + 1) continue;                                                   // only blocks below it
          if (Math.min(a.l + a.w, b.l + b.w) - Math.max(a.l, b.l) <= 4) continue;            // in the same column
          if (!isFinite(b.lead)) continue;
          const over = a.top + a.shift + a.ink - (b.top + b.shift + b.lead);                // text against content, not frame edges
          if (over > 1) it.forEach(c => { if (c.top >= b.top) c.shift += over; });   // flush rows stay flush
        }
      }
      it.forEach(c => { if (c.shift) { c.e.style.marginTop = `${c.shift}px`; c.e.dataset.settled = ''; } });
      const bottom = Math.max(0, ...it.map(c => c.top + c.shift + c.h));
      if (box !== canvas && box.style.height && bottom > box.clientHeight + 1) {
        box.dataset.h0 ??= box.style.height;
        box.style.height = `${bottom}px`;
        box.dataset.settled = '';
      }
      return bottom;
    };
    let busy = false;
    const run = () => {
      if (busy) return;
      busy = true;
      reset();
      if (desk.matches) {
        canvas.dataset.h0 ??= canvas.style.height;
        const bottom = settle(canvas);
        if (bottom > canvas.clientHeight) canvas.style.height = `${bottom}px`;
      }
      dispatchEvent(new Event('resize'));                  // scroll triggers and smooth scroll re-measure the page
      busy = false;
    };
    let t = 0;
    addEventListener('resize', () => { if (!busy) { clearTimeout(t); t = window.setTimeout(run, 200); } });
    document.fonts.ready.then(run);
    // faces used further down the page can arrive later and change how tall text is
    document.fonts.addEventListener('loadingdone', () => { clearTimeout(t); t = window.setTimeout(run, 100); });
    addEventListener('load', run);
  }
  import('../../scripts/case-motion');
</script>

<style>
  :global(body) { background: var(--paper); }
  .swad-canvas :global(.swad-link:hover) { color: var(--accent) !important; }
  /* tags and counts grow with their text, which has a minimum size on small windows */
  .swad-canvas :global([data-name^="Tag"]) { width: max-content !important; height: auto !important; padding: calc(4 * var(--u)) calc(12 * var(--u)); }
  .swad-canvas :global([data-name^="Tag"] p) { position: static !important; }
  .swad-canvas :global([data-name="Count"]) { width: 100% !important; }
  /* the same nav as the other case studies */
  /* "Met" sits on a black tag: Figma has it dark on dark */
  .swad-canvas :global([data-name="Tag Met"] p) { color: #fcfbf8 !important; }
  /* the grid narrows some text by a line: let it run rather than clip (images keep their crop) */
  @media (min-width: 901px) { .swad-canvas :global([data-name]:not([data-name^="Image:"]):not([data-name^="Image band"]):not([data-name^="Hero"])) { overflow: visible !important; } }
  .swad-canvas :global(.swad-photo) { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; object-fit: cover; }

  /* phones: the absolute layout falls into reading order (the converter sorts layers top to bottom); type keeps a
     readable scale by giving this page a larger design pixel */
  @media (max-width: 900px) {
    .swad-canvas { --u: 0.55px; height: auto !important; padding: 0 20px 48px; display: block; }
    /* the Figma sizes mapped onto the case studies' shared phone scale (styles/case.css): title and figures,
       section headings, sub-headings and quotes */
    .swad-canvas :global([style*="font-size: calc(61 * var(--u))"]) { font-size: 40px !important; }
    .swad-canvas :global([style*="font-size: calc(49 * var(--u))"]) { font-size: 34px !important; }
    .swad-canvas :global([style*="font-size: calc(31 * var(--u))"]) { font-size: 24px !important; }
    .swad-canvas :global(*) { position: static !important; left: auto !important; top: auto !important; transform: none !important;
      width: auto !important; max-width: 100%; white-space: normal !important; }
    .swad-canvas :global(div:not(:has(*))) { height: auto; min-height: 1px; }
    .swad-canvas :global(p) { height: auto !important; margin-top: 12px; }
    .swad-canvas :global([data-name^="Image"]), .swad-canvas :global([data-name*="placeholder"]) { height: 240px !important; margin: 24px -20px 0; }
    .swad-canvas :global(img) { display: inline-block; width: auto !important; }
    .swad-canvas :global([data-name^="Image"] p) { padding: 0 20px; }
    /* photos run edge to edge; the hero starts at the top of the page */
    .swad-canvas :global([data-name^="Image:"]), .swad-canvas :global([data-name*="placeholder"]) { max-width: none; }
    .swad-canvas :global([data-name^="Hero"]) { margin-top: 0 !important; height: 300px !important; }
    .swad-canvas :global(.swad-photo) { display: block; width: 100% !important; height: 100%; object-fit: cover; }
    .swad-canvas :global([data-name^="Image"]:has(> .swad-photo)), .swad-canvas :global([data-name*="placeholder"]) { overflow: hidden; }
    .swad-canvas :global([data-name^="Image"]:has(> .swad-photo) > :not(.swad-photo)) { display: none; }
  }
</style>
