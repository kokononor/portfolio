  .street__marks i, .swatch { display: block; width: calc(13 * var(--u)); height: calc(13 * var(--u)); min-width: 5px; min-height: 5px; border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 13%, transparent); transition: background-color .7s ease, transform .7s cubic-bezier(.2, .7, .2, 1); }
  .street__marks .noticed, .swatch.noticed { background: color-mix(in srgb, var(--ink) 42%, transparent); }
