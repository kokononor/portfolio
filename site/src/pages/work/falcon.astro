<script>
  import '../../scripts/case-motion';
  import { playFalcon } from '../../scripts/falcon-screen';

  // every Falcon screen is drawn at 1600 × 875 and scaled to the box it sits in
  document.querySelectorAll<HTMLElement>('.fs-host').forEach(host => {
    const screen = host.querySelector<HTMLElement>('.fs')!;
    new ResizeObserver(() => { screen.style.transform = `scale(${host.clientWidth / 1600})`; }).observe(host);
  });
  // "See in motion" on the stage: the screen comes alive
  document.querySelectorAll<HTMLElement>('[data-falcon-play]').forEach(b => b.addEventListener('click', () => {
    b.closest('.stage')?.classList.add('is-playing');
    playFalcon(document.getElementById(b.dataset.falconPlay!)!);
  }));
  // without the stage (phones, reduced motion), the live screen opens in a dialog
  const dialog = document.querySelector<HTMLDialogElement>('[data-falcon-dialog]');
  document.querySelector('[data-falcon-open]')?.addEventListener('click', () => {
    if (!dialog) return;
    dialog.showModal();
    (window as any).__lenis?.stop();
    playFalcon(document.getElementById('falcon-dialog')!);
  });
  dialog?.querySelector('[data-falcon-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('close', () => (window as any).__lenis?.start());
</script>

