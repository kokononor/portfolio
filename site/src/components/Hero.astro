---
// Section 1 — nav and hero. Figma: 362:6 (nav), 362:17–362:36 (hero), 362:1715 (signature), 362:1382 (record player).
// Desktop positions are the design's coordinates in design pixels (var(--u)); phones get a stacked flow layout.
import { Image } from 'astro:assets';
import portrait from '../assets/home/portrait.jpg';
import arrowDown from '../assets/home/arrow-down.svg?url';
import RecordPlayer from './RecordPlayer.astro';
import Nav from './Nav.astro';
import signatureMask from '../assets/home/signature-mask.png';
import divinitiLogo from '../assets/home/diviniti-emblem.png';
import viLogo from '../assets/falcon/vi-logo.png';
---
<header class="hero fit" id="top" style="--fit-h: 1074; --fit-room: 100svh">
  <Nav />

  <!-- the dateline: today's edition (scripts/edition.ts fills in the date, number and Delhi's weather) -->
  <p class="hero__dateline t-mono" data-edition data-hero-in></p>
  <h1 class="hero__title t-display" data-greet="Namaste!|Hello!|Bonjour!">Namaste!</h1>
  <p class="hero__lede t-serif" data-hero-in>
    <span class="em">Zero to one product designer</span> with one simple rule: <span class="em">the user wins and the business doesn’t lose.</span>
    <span class="hero__caps"><span>Enterprise UX<i aria-hidden="true">/</i></span><span>Product Strategy<i aria-hidden="true">/</i></span><span>E&#8209;commerce<i aria-hidden="true">/</i></span><span>AI Experiences<i aria-hidden="true">/</i></span><span>Systems Thinking</span></span>
  </p>
  <div class="hero__rule" data-hero-in></div>

  <dl class="hero__facts" data-hero-in>
    <div class="fact fact--current"><dt>Current</dt><dd><span class="fact__name"><Image class="fact__logo" src={divinitiLogo} alt="" widths={[40, 80]} sizes="20px" loading="eager" />Diviniti Luxury</span><small>Founder’s Office</small></dd></div>
    <div class="fact fact--previous"><dt>Previous</dt><dd><span class="fact__name"><Image class="fact__logo" src={viLogo} alt="" widths={[40, 80]} sizes="20px" loading="eager" />Vodafone Idea</span><small>Intern</small></dd></div>
    <div class="fact fact--based"><dt>Based In</dt><dd><span class="fact__name"><svg class="fact__pin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21.5s-7-6.1-7-11.8a7 7 0 0 1 14 0c0 5.7-7 11.8-7 11.8Z" /><circle cx="12" cy="9.7" r="2.6" /></svg>Delhi, India</span></dd></div>
  </dl>

  <div class="hero__player" data-hero-in>
    <RecordPlayer />
    <p class="player-note" aria-hidden="true">
      <span class="player-note__state"><span class="eq"><i></i><i></i><i></i></span><span class="player-note__on">Now playing</span><span class="player-note__off">Paused</span></span>
      <span class="player-note__track">The Smiths · Heaven Knows I'm Miserable Now</span>
    </p>
  </div>

  <figure class="hero__portrait" data-hero-in>
    <div class="hero__photo" data-halftone>
      <Image src={portrait} alt="Suyash as a child, running down a street in Ranchi" widths={[433, 866, 1299]} sizes="(max-width: 900px) 90vw, 433px" loading="eager" />
      <span class="hero__signature" style={`--mask: url('${signatureMask.src}')`} aria-hidden="true"></span>
    </div>
    <figcaption class="hero__caption">
      Born and brought up in Ranchi, Jharkhand by an Editor father <span class="t-mono">(*can guess by the design style)</span> and a Business Owner mother <span class="t-mono">(*evident in my projects)</span>.
    </figcaption>
    <p class="hero__tags"><span>Still Curious</span><span>Still Designing</span></p>
  </figure>
</header>

<script>
  import '../scripts/greeting';
  import '../scripts/edition';
</script>

<style>
  .hero { position: relative; height: calc(1074 * var(--u)); }

  /* ---- the bass: with the record on, --beat (0 to 1, the song's low end, scripts/record-player.ts) moves what sits
     around the player. Strongest beside it, fading outwards, so each hit ripples left from the record. Individual
     scale / translate properties, so the entrance animations (transform) are never overridden. ---- */
  .hero__facts .fact { translate: 0 calc(var(--beat, 0) * var(--lift) * -1px); transition: translate .12s ease-out; }
  .hero__facts .fact--based { --lift: 5; }
  .hero__facts .fact--previous { --lift: 3.5; }
  .hero__facts .fact--current { --lift: 2.2; }
  .hero__facts :global(.fact__logo), .hero__facts .fact__pin { scale: calc(1 + var(--beat, 0) * .28); transition: scale .12s ease-out; }
  /* (the rule's own transforms belong to its entrance animation, so it thickens with a shadow instead) */
  .hero__rule { border-color: color-mix(in oklab, var(--ink), var(--accent) calc(var(--beat, 0) * 100%));
    box-shadow: 0 0 0 calc(var(--beat, 0) * .9px) color-mix(in oklab, var(--ink), var(--accent) calc(var(--beat, 0) * 100%));
    transition: border-color .12s ease-out, box-shadow .12s ease-out; }
  .hero__player :global(.player) { scale: calc(1 + var(--beat, 0) * .025); transition: scale .1s ease-out; }
  .player-note__state { color: color-mix(in oklab, currentColor, var(--accent) calc(var(--beat, 0) * 90%)); }
  .hero > * { position: absolute; }


  /* ---- the dateline: a line of small print above the greeting, like the strip under a newspaper's masthead ---- */
  .hero__dateline { left: calc(104 * var(--u)); top: calc(196 * var(--u)); margin-left: calc(104 * var(--dx)); display: flex; flex-wrap: wrap; gap: 4px 0;
    font-size: max(11px, calc(13 * var(--u))); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .hero__dateline :global(span + span)::before { content: '·'; margin: 0 .9em; color: var(--muted); }

  /* ---- greeting and lede (362:17, 362:18) ---- */
  .hero__title { left: calc(104 * var(--u)); top: calc(245.35 * var(--u)); width: calc(1005 * var(--u));
    font-size: calc(290 * var(--u)); line-height: 0.976; white-space: nowrap; }
  /* the greeting (see scripts/greeting.ts): the words share one grid cell; each letter sits in a cell pinned to its
     resting width, and inks in through Fraunces' weight and softness axes (--w, --s) */
  .hero__title { display: grid; }
  .hero__title :global(.greet) { grid-area: 1 / 1; display: block; visibility: hidden; white-space: nowrap; }
  .hero__title :global(.greet__cell) { display: inline-flex; justify-content: center; vertical-align: top; }
  .hero__title :global(.greet__ch) { --w: 300; --s: 0; font-variation-settings: 'wght' calc(var(--w) + var(--beat, 0) * 90), 'SOFT' var(--s), 'WONK' 1; }   /* --beat: the record's bass swells the ink */
  .hero__lede { left: calc(104 * var(--u)); top: calc(567.35 * var(--u)); width: calc(1005 * var(--u));
    font-size: max(20px, calc(31 * var(--u))); font-style: italic; line-height: 1.25; }
  .hero__lede .em { font-weight: 400; line-height: normal; }
  /* what I work on: one quiet line of small print under the introduction */
  .hero__caps { display: flex; flex-wrap: wrap; gap: 4px 0; margin-top: calc(8 * var(--u)); font-family: var(--mono); font-style: normal; font-weight: 400;
    font-size: max(10px, calc(12 * var(--u))); line-height: 1.4; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .hero__caps i { font-style: normal; margin: 0 .9em; color: var(--accent); opacity: .7; }
  .hero__rule { left: calc(104 * var(--u)); top: calc(695.35 * var(--u)); width: calc(1005 * var(--u)); height: 0;
    border-top: 0.5px solid var(--ink); }

  /* ---- facts (362:20, 362:25, 362:30) ---- */
  .hero__facts { left: 0; right: 0; top: calc(747.35 * var(--u)); }   /* spans by its edges, so its margin can't push it past the page */
  .fact { position: absolute; top: 0; width: max-content !important; display: flex; flex-direction: column; gap: calc(6.5 * var(--u)); }
  .fact--current { left: calc(104 * var(--u)); width: calc(157 * var(--u)); }
  .fact--previous { left: calc(358 * var(--u)); width: calc(165 * var(--u)); }
  .fact--based { left: calc(620 * var(--u)); width: calc(122 * var(--u)); }
  /* small marks before each name: the company logos and a location pin, sized to the text */
  .fact__name { display: inline-flex; align-items: center; gap: 0.32em; white-space: nowrap; }
  .fact__name :global(.fact__logo) { flex: none; width: 0.82em; height: 0.82em; object-fit: contain; }
  .fact__pin { flex: none; width: 0.78em; height: 0.78em; fill: none; stroke: var(--ink); stroke-width: 1.4; }
  .fact dt { font-size: max(12px, calc(16 * var(--u))); font-style: italic; }
  .fact dd { font-size: max(16px, calc(25 * var(--u))); line-height: 1.4; }
  .fact dd small { display: block; white-space: nowrap; margin-top: calc(4 * var(--u)); font-size: max(12px, calc(16 * var(--u))); font-style: italic; line-height: normal; }

  /* ---- record player (362:1382): at the end of the facts row, its right edge on the rule's end ---- */
  .hero__player { left: calc(835 * var(--u)); top: calc(744 * var(--u)); width: calc(204 * var(--u)); }   /* sits just after the facts row, not out at the rule's end */
  /* the music label under it: what's on, and whether it's playing */
  .player-note { margin: calc(14 * var(--u)) 0 0; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; white-space: nowrap; text-align: right; }
  .player-note__state { display: inline-flex; align-items: center; gap: 6px; font-family: var(--mono); font-size: max(12px, calc(13 * var(--u)));
    letter-spacing: .06em; text-transform: uppercase; color: var(--ink); }
  .player-note__track { font-family: var(--serif); font-variation-settings: 'SOFT' 0, 'WONK' 1; font-style: italic; font-weight: 300;
    font-size: max(12px, calc(16 * var(--u))); }
  /* three small bars that dance while the record plays */
  .eq { display: inline-flex; align-items: flex-end; gap: 1.5px; height: 9px; }
  .eq i { width: 2px; height: 30%; background: var(--accent); transition: height .4s ease; }
  .player-note__on, .player-note__off { display: none; }
  .hero__player:has(.player[aria-pressed='true']) .player-note__on,
  .hero__player:not(:has(.player[aria-pressed='true'])) .player-note__off { display: inline; }
  .hero__player:has(.player[aria-pressed='true']) .eq i { animation: eq .9s ease-in-out infinite alternate; }
  .hero__player:has(.player[aria-pressed='true']) .eq i:nth-child(2) { animation-delay: -.3s; animation-duration: .7s; }
  .hero__player:has(.player[aria-pressed='true']) .eq i:nth-child(3) { animation-delay: -.6s; animation-duration: 1.1s; }
  @keyframes eq { from { height: 25%; } to { height: 100%; } }
  @media (prefers-reduced-motion: reduce) { .eq i { animation: none !important; height: 60%; } }

  /* ---- portrait, signature, caption (362:33–362:36, 362:1715) ---- */
  .hero__portrait { left: calc(1191 * var(--u)); top: calc(194 * var(--u)); width: calc(433 * var(--u));   /* 12% wider than the 386 design; the right edge stays on the margin (1624) */
    position: absolute; }
  .hero__photo { position: relative; width: 100%; height: calc(540 * var(--u)); }
  .hero__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: bottom; }
  /* the signature: ink through the signature mask, over the bottom-right of the photo */
  .hero__signature { position: absolute; left: calc(332 * var(--u)); top: calc(470 * var(--u)); width: calc(192 * var(--u)); height: calc(115 * var(--u));
    background: var(--ink); -webkit-mask: var(--mask) no-repeat calc(-18 * var(--u)) calc(-6 * var(--u)) / calc(204 * var(--u)) calc(136 * var(--u));
    mask: var(--mask) no-repeat calc(-18 * var(--u)) calc(-6 * var(--u)) / calc(204 * var(--u)) calc(136 * var(--u)); }
  .hero__caption { margin-top: calc(26 * var(--u)); font-size: max(14px, calc(16 * var(--u))); font-weight: 400; line-height: 1.55; }
  /* the tags follow the caption (so a longer caption on small screens pushes them down instead of overlapping) */
  .hero__tags { position: static; margin-top: calc(33 * var(--u)); display: flex; gap: calc(8 * var(--u)); font-size: max(12px, calc(16 * var(--u))); font-style: italic; }
  .hero__tags span { white-space: nowrap; }
  .hero__tags span:last-child { width: calc(115 * var(--u)); text-align: right; }

  /* ---- full width on short, wide screens (see .fit): the left column keeps to the left margin, the player and
     portrait to the right one, and the rule stretches between ---- */
  .hero__title, .hero__lede, .hero__rule, .hero__facts { margin-left: calc(104 * var(--dx)); }
  .hero__rule { width: calc(1005 * var(--u) + 1520 * var(--dx)); }
  .hero__lede { width: calc(1005 * var(--u) + 760 * var(--dx)); }   /* on wide, short screens the intro runs a little wider into the middle */
  .hero__portrait { margin-left: calc(1624 * var(--dx)); }
  .hero__player { margin-left: calc(104 * var(--dx)); }   /* the turntable travels with the facts row, not the right margin */

  /* ---- phones and small tablets: stacked ---- */
  @media (max-width: 900px) {
    .hero { height: auto; padding: 20px 20px 56px; display: flex; flex-direction: column; }
    .hero > * { position: static; }
    .hero__dateline { order: 0; margin-top: 72px; white-space: normal; gap: 3px 16px; }
    .hero__dateline :global(span + span)::before { content: none; }   /* phones: the items wrap, so spacing separates them, not dots */
    .hero__dateline + .hero__title { margin-top: 10px; }
    .hero__title { order: 1; margin-top: 72px; font-size: clamp(64px, 21vw, 120px); width: auto; }
    .hero__lede { order: 2; margin-top: 20px; width: auto; font-size: 20px; }
    .hero__rule { order: 3; width: 100%; margin: 28px 0; }
    .hero__facts { order: 4; position: static; display: flex; flex-wrap: wrap; gap: 20px 32px; }
    .fact { position: static; width: auto !important; gap: 6px; }
    .hero__player { order: 5; margin-top: 36px; }
    /* the player and its label side by side, instead of the player alone on a row */
    .hero__player { width: 100%; display: flex; align-items: center; gap: 16px; }
    .hero__player > :global(.player) { flex: none; width: min(204px, 52%); }
    .player-note { align-items: flex-start; text-align: left; margin-top: 0; white-space: normal; }
    .hero__portrait { order: 6; width: min(386px, 100%); margin-top: 48px; }
    .hero__photo { height: auto; aspect-ratio: 386 / 540; }
    /* on phones the photo is the full width, so the signature stays inside it instead of running off the page and
       over the caption */
    .hero__signature { left: 48%; top: 78%; width: 49.7%; height: 21.3%;
      -webkit-mask-size: 106% 118%; mask-size: 106% 118%; -webkit-mask-position: -9% -5%; mask-position: -9% -5%; }
    .hero__caption { margin-top: 18px; }
    .hero__tags { position: static; margin-top: 18px; gap: 14px; }
    .hero__tags span:last-child { width: auto; }
  }
  /* tablets: the player and the portrait share a row, so neither leaves half the width empty */
  @media (min-width: 600px) and (max-width: 900px) {
    .hero { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; align-items: start; }
    .hero > * { grid-column: 1 / -1; }
    .hero > .hero__player { grid-column: 1; flex-direction: column; align-items: flex-start; margin-top: 48px; }
    .hero__player > :global(.player) { width: 100%; }
    .hero > .hero__portrait { grid-column: 2; width: 100%; }
    .hero__signature { left: 50%; }   /* this column ends at the page's margin, so the signature stays on the photo */
  }
  @media (min-width: 601px) and (max-width: 900px) { .hero { padding-left: 40px; padding-right: 40px; } }
</style>
