---
// Footer. Figma: Group 16 (362:x) — the dark band, "Thanks for Reading", the white link panel and the colour dots.
// It starts at design y 6833; the frame ends 571px later.
// The panel starts one gutter before the grid's 9th column, so its two link columns sit on columns 9–10 and 11–12
// and end on the page's right margin; the swatches (the site's four inks, a printer's colour bar) end there too.
---
<footer class="footer" id="archive">
  <div class="footer__band">
    <div class="footer__end">
      <p class="footer__label">END OF EDITION · 2026</p>
      <p class="footer__thanks t-display">Thanks for <em>Reading</em></p>
    </div>
  </div>
  <div class="footer__panel">
    <div class="footer__cols">
      <ul>
        <li><a href="/resume.pdf" download="Suyash-Resume.pdf">Download Resume</a></li>
        <li><a href="https://www.linkedin.com/in/suyashhsayus/" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="https://www.instagram.com/notfiguredyet/" target="_blank" rel="noopener">Instagram</a></li>
        <li><a href="https://www.behance.net/suyashhsayus" target="_blank" rel="noopener">Behance</a></li>
      </ul>
      <ul class="footer__site">
        <li><a href="/">Home</a></li>
        <li><a href="/#work">Work</a></li>
        <li><a href="/#about">About</a></li>
        <li><a href="/#contact">Connect</a></li>
      </ul>
    </div>
    <!-- the colour bar works: a press reprints this edition in the next ink (see the script below) -->
    <button class="footer__dots" type="button" data-reink aria-label="Reprint this edition in another ink" title="Reprint in another ink">
      <svg viewBox="0 0 96 24" aria-hidden="true">
        <circle cx="12" cy="12" r="12" fill="var(--accent)" />
        <circle cx="36" cy="12" r="12" fill="var(--accent-deep)" />
        <circle cx="60" cy="12" r="12" fill="var(--muted)" />
        <circle cx="84" cy="12" r="12" fill="var(--ink)" />
      </svg>
      <span class="footer__ink" aria-live="polite"></span>
    </button>
  </div>
</footer>

<script>
  // Reprinting: each press of the colour bar inks the whole edition in the next spot colour, wiping out from the bar.
  // The choice lasts for the visit (layouts/Base.astro applies it before each page paints).
  const inks = (window as any).__inks as { name: string }[];
  const bar = document.querySelector<HTMLButtonElement>('[data-reink]');
  const note = bar?.querySelector<HTMLElement>('.footer__ink');
  const ORDINAL = ['First', 'Second', 'Third', 'Fourth'];
  const say = (i: number) => { if (note) note.textContent = i ? `${ORDINAL[i]} printing · ${inks[i].name}` : ''; };
  let at = +(sessionStorage.getItem('ink') || 0) % inks.length;
  say(at);
  bar?.addEventListener('click', () => {
    at = (at + 1) % inks.length;
    const apply = () => { (window as any).__ink(at); say(at); };
    try { sessionStorage.setItem('ink', String(at)); } catch {}
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (still || !document.startViewTransition) return apply();
    const r = bar.getBoundingClientRect(), x = r.left + r.width / 2, y = r.top + r.height / 2;
    const far = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    document.documentElement.classList.add('is-reinking');
    const t = document.startViewTransition(apply);
    t.ready.then(() => document.documentElement.animate(
      { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${far}px at ${x}px ${y}px)`] },
      { duration: 900, easing: 'cubic-bezier(.3, 0, .1, 1)', pseudoElement: '::view-transition-new(root)' }));
    t.finished.finally(() => document.documentElement.classList.remove('is-reinking'));
  });
</script>

<style>
  .footer { position: relative; height: calc(571 * var(--u)); }
  /* the band runs the full window width, under the 1728 canvas */
  .footer__band { position: absolute; top: 0; bottom: 0; left: calc(50% - var(--vw, 100vw) / 2); width: var(--vw, 100vw); background: var(--grad-footer); }
  /* the text sits in the band, which starts at the window edge: offset it back onto the canvas grid */
  .footer__end { position: absolute; left: calc((var(--vw, 100vw) - 1728 * var(--u)) / 2 + 104 * var(--u)); top: calc(257 * var(--u)); width: calc(597 * var(--u)); color: var(--paper); }
  .footer__label { font-size: max(12px, calc(16 * var(--u))); letter-spacing: .04em; }
  .footer__thanks { margin-top: calc(13 * var(--u)); font-size: calc(100 * var(--u)); line-height: 0.98; }
  .footer__thanks em { display: block; font-style: italic; }

  /* the panel runs on to the window's right edge, so wide screens never show the dark band beside it */
  .footer__panel { position: absolute; left: calc(1096 * var(--u)); top: 0; height: 100%;
    width: calc(632 * var(--u) + (var(--vw, 100vw) - 1728 * var(--u)) / 2); background: var(--grad-footer-panel); }
  .footer__cols { position: absolute; left: calc(64 * var(--u)); top: calc(61 * var(--u)); width: calc(464 * var(--u));
    display: grid; grid-template-columns: 1fr 1fr; column-gap: calc(64 * var(--u));
    font-size: max(12px, calc(16 * var(--u))); letter-spacing: .04em; line-height: 1.5; }
  .footer__cols ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: calc(26 * var(--u)); text-transform: uppercase; }
  .footer__cols a { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .4s ease, color .3s ease; }
  .footer__cols a:hover { background-size: 100% 1px; color: var(--accent); }
  .footer__dots { padding: 0; border: 0; background: none; cursor: pointer; }
  .footer__dots svg { display: block; width: 100%; height: 100%; transition: transform .4s cubic-bezier(.2, .7, .2, 1); }
  .footer__dots:hover svg { transform: translateY(-3px); }
  .footer__ink { position: absolute; right: 0; bottom: calc(100% + 10px); white-space: nowrap; font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .footer__dots { position: absolute; left: calc(64 * var(--u) + 464 * var(--u) - 96 * var(--u)); bottom: calc(61 * var(--u)); width: calc(96 * var(--u)); height: calc(24 * var(--u)); }

  @media (max-width: 900px) {
    .footer { height: auto; margin-top: 72px; display: flex; flex-direction: column-reverse; }
    .footer__band { position: relative; left: auto; width: 100%; padding: 64px 20px; }
    .footer__end { position: static; width: auto; }
    .footer__thanks { font-size: 56px; }
    .footer__panel { position: relative; left: auto; width: 100%; height: auto; padding: 40px 20px 32px; }
    .footer__cols { position: static; width: auto; column-gap: 20px; font-size: 14px; }
    .footer__dots { position: relative; display: block; margin: 40px 0 0 auto; width: 96px; height: 24px; }
  }

  @media (max-width: 900px) { .footer__cols ul { gap: 0; } .footer__cols a { display: inline-block; padding: 12px 0; } }
</style>
