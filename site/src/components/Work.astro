---
// Section 2 — kaam (curated works). Figma: 362:37/38 (labels), 362:39 + 362:42 (Falcon), 362:74 (Redefining Design),
// 362:102–362:104 (Swad). The section starts at design y 1074; coordinates below are relative to that.
import { Image } from 'astro:assets';
import diviniti from '../assets/home/diviniti-cover.png';
import viLogo from '../assets/falcon/vi-logo.png';
import swadLogo from '../assets/home/swad-logo.png';
import divinitiLogo from '../assets/home/diviniti-logo.png';
import arrowDown from '../assets/home/arrow-down.svg?url';
---
<section class="work" id="work" aria-labelledby="work-title">

  <!-- Falcon: a night card around the film of the case study (components/FalconFilm.astro, exported as an MP4 by
       scripts/falcon-film-export.ts). The film loops seamlessly. -->
  <div class="slide slide--first">
  <div class="slide__stack">
  <h2 class="work__word t-display" id="work-title">kaam</h2>
  <p class="work__label">CURATED WORKS</p>
  <article class="falcon" data-reveal>
    <Image class="falcon__logo" src={viLogo} alt="Vodafone Idea" widths={[64, 128]} sizes="64px" />
    <div class="falcon__film">
      <!-- phones get the 720p cut; nothing of the film is fetched until the card is about to come into view.
           H.264 (High 4.0 / Main 3.1, the levels every hardware decoder takes) first, VP9 for browsers without H.264
           (Firefox on Windows N editions); the codecs in each type let a browser skip what it can't decode. -->
      <video class="falcon__video" data-falcon-cover poster="/media/falcon-film-poster.webp" muted loop playsinline preload="none"
        aria-label="Falcon in motion: five disconnected data sources resolve into three root causes, then into the redesigned Falcon dashboard.">
        <source src="/media/falcon-film-720.mp4" type='video/mp4; codecs="avc1.4D401F"' media="(max-width: 900px)" />
        <source src="/media/falcon-film-720.webm" type='video/webm; codecs="vp9"' media="(max-width: 900px)" />
        <source src="/media/falcon-film.mp4" type='video/mp4; codecs="avc1.640028"' />
        <source src="/media/falcon-film.webm" type='video/webm; codecs="vp9"' />
      </video>
      <!-- shown when the film may not start by itself: reduced motion asked for, or autoplay blocked by the browser -->
      <button class="falcon__play" type="button" data-falcon-play hidden aria-label="Play the Falcon film" data-cursor="Play">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-play" d="M8 5.5v13l11-6.5z" /><path class="i-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
      </button>
    </div>
    <div class="case case--light falcon__case">
      <p class="case__meta">FALCON · VI SNOC <span class="dot dot--light"></span>2026</p>
      <h3 class="case__title t-serif">Making millions of network events explain a <em>single outage.</em></h3>
      <p class="case__lede">A network operations dashboard, redesigned for the moments when every minute of downtime counts.</p>
      <hr class="case__rule" />
      <dl class="case__facts">
        <div class="case__outcome"><dt>Outcome</dt><dd>Evidence for an outage correlated in under 10 seconds, down from a minute</dd></div>
        <div><dt>Company</dt><dd>Vodafone Idea</dd></div>
        <div><dt>Role</dt><dd>Product design intern</dd></div>
      </dl>
      <div class="case__links"><a class="case__more" href="/work/falcon">Read More</a><a class="case__paper" href="/papers/falcon-research-paper.pdf" download="Falcon-Research-Paper.pdf">Research paper (PDF) <img src={arrowDown} width="12" height="18" alt="" /></a></div>
    </div>
  </article>
  </div>
  </div>

  <!-- Swad: a dark visual card beside a white text card -->
  <div class="slide">
  <div class="swad">
    <!-- before / after: the café as it is (with its sign) underneath, the stall as it was revealed from the left up to the
         divider. A range input over the photo moves it: drag anywhere, or use the arrow keys. -->
    <div class="swad__visual" style="view-transition-name: vt-swad" data-reveal data-compare>
      <img class="swad__plate" src="/work/swad/photos/hero.webp" alt="Swad today: a clean counter with menus, pendant lights and the House of Swad sign" loading="lazy" />
      <Image class="swad__logo" src={swadLogo} alt="" widths={[320, 640]} sizes="(max-width: 900px) 160px, 260px" />
      <div class="swad__before"><img src="/work/swad/photos/cover-before.webp" alt="Swad before: a night-time stall behind a wire grille, with a chalkboard menu" loading="lazy" /></div>
      <span class="swad__divider" aria-hidden="true"><i></i></span>
      <span class="swad__tag swad__tag--before" aria-hidden="true">Before</span>
      <span class="swad__tag swad__tag--after" aria-hidden="true">After</span>
      <input class="swad__range" type="range" min="0" max="100" value="50" step="0.5" aria-label="Compare Swad before and after the redesign" />
    </div>
    <article class="swad__body case" data-reveal>
      <p class="case__meta">SWAD · MOMO CAFÉ <span class="dot"></span>2026</p>
      <h3 class="case__title t-serif">How a momo café that couldn’t make rent <em>found its regulars.</em></h3>
      <p class="case__lede">A quiet-lane café in Ranchi went from losing ₹10,000 a month to ₹20,000 in profit in six months.</p>
      <hr class="case__rule" />
      <dl class="case__facts">
        <div class="case__outcome"><dt>Outcome</dt><dd>−₹10,000 to +₹20,000 a month, about 8 in 10 orders from regulars</dd></div>
        <div><dt>Company</dt><dd>Swad, a family-owned café</dd></div>
        <div><dt>Role</dt><dd>Product manager</dd></div>
      </dl>
      <div class="case__links"><a class="case__more" href="/work/swad">Read More</a></div>
    </article>
  </div>
  </div>

  <!-- Redefining Design: a full-width image card -->
  <div class="slide">
  <article class="story case case--light" data-reveal>
    <div class="story__bg" style="view-transition-name: vt-diviniti"><Image src={diviniti} alt="" widths={[768, 1280, 1774]} sizes="(max-width: 900px) 100vw, 1520px" data-parallax="6" /></div>
    <Image class="card-logo card-logo--diviniti" src={divinitiLogo} alt="Diviniti" widths={[120, 240]} sizes="120px" />
    <div class="story__body">
      <p class="case__meta">DIVINITI <span class="dot dot--light"></span>2025–26</p>
      <h3 class="case__title t-serif">A year that took my design from <em>pixels to platforms.</em></h3>
      <p class="case__lede">From lighting product images by hand to the product data behind the site, its marketplaces and its AI.</p>
      <hr class="case__rule" />
      <dl class="case__facts">
        <div class="case__outcome"><dt>Outcome</dt><dd>A 40% increase in Amazon sales, with Portrait on Gold and the chatbot Amy both live and in use</dd></div>
        <div><dt>Company</dt><dd>Diviniti India</dd></div>
        <div><dt>Role</dt><dd>Design intern, then Founder’s Office</dd></div>
      </dl>
      <div class="case__links"><a class="case__more" href="/work/diviniti">Read More</a></div>
    </div>
  </article>
  </div>
</section>

<script>
  // the Falcon film plays only while its card is on screen. With reduced motion asked for (Windows turns this on with
  // "Animation effects" off) it waits for the play button; if the browser blocks autoplay, the button appears too.
  const film = document.querySelector<HTMLVideoElement>('[data-falcon-cover]');
  const playBtn = document.querySelector<HTMLButtonElement>('[data-falcon-play]');
  if (film && playBtn) {
    let wanted = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let inView = false;
    const sync = () => {
      const playing = !film.paused;
      playBtn.classList.toggle('is-playing', playing);
      playBtn.setAttribute('aria-label', playing ? 'Pause the Falcon film' : 'Play the Falcon film');
      playBtn.dataset.cursor = playing ? 'Pause' : 'Play';
    };
    const play = () => film.play().catch((err: DOMException) => {
      if (err?.name === 'NotAllowedError') { wanted = false; playBtn.hidden = false; }   // the visitor starts it instead
    });
    film.addEventListener('play', sync);
    film.addEventListener('pause', sync);
    if (!wanted) playBtn.hidden = false;
    // no source could be decoded: the poster stays, and a button that can't do anything goes
    film.querySelectorAll('source').forEach(s => s.addEventListener('error', () => setTimeout(() => {
      if (film.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) playBtn.hidden = true;
    })));

    // start fetching a screen before the card arrives, so it is already playing when it does
    if (wanted) new IntersectionObserver(([e], io) => { if (e.isIntersecting) { film.preload = 'auto'; film.load(); io.disconnect(); } }, { rootMargin: '100% 0px' }).observe(film);
    new IntersectionObserver(([e]) => {
      inView = e.isIntersecting;
      if (inView && wanted) play(); else if (!inView) film.pause();
    }, { threshold: 0.25 }).observe(film);

    playBtn.addEventListener('click', () => {
      if (film.paused) { wanted = true; film.preload = 'auto'; play(); }
      else { wanted = false; film.pause(); }
    });
  }

  // Swad's before / after: the range sets where the divider is; it nudges once when it first comes into view
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach(box => {
    const range = box.querySelector<HTMLInputElement>('.swad__range')!;
    const set = (v: number) => box.style.setProperty('--cut', `${v}%`);
    range.addEventListener('input', () => { box.classList.add('is-used'); set(+range.value); });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    new IntersectionObserver(([e], io) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now();
      const nudge = (now: number) => {
        if (box.classList.contains('is-used')) return;
        const k = Math.min((now - t0) / 1400, 1);
        set(50 + Math.sin(k * Math.PI * 2) * 12 * (1 - k));   // out to the right, back past the middle, settle
        if (k < 1) requestAnimationFrame(nudge);
      };
      setTimeout(() => requestAnimationFrame(nudge), 500);
    }, { threshold: 0.6 }).observe(box);
  });

  // a click anywhere on a project card opens its case study, unless it was on another link or selected some text;
  // ctrl / ⌘ click opens it in a new tab, as a link would
  document.querySelectorAll<HTMLElement>('.falcon, .swad, .story').forEach(card => {
    const link = card.querySelector<HTMLAnchorElement>('.case__more');
    if (!link) return;
    card.addEventListener('click', e => {
      if ((e.target as Element).closest('a, button, .swad__range') || getSelection()?.toString()) return;   // (dragging the before / after is not a click)
      if (e.metaKey || e.ctrlKey) window.open(link.href, '_blank');
      else link.click();
    });
  });
</script>

<style>
  /* --pu: the page's design pixel (cards redefine --u for their own height-fitted scale) */
  .work { position: relative; --pu: var(--u); }

  /* one card per slide, each fitted to the screen (its own --u). Slides hug their cards: a fixed 96 design px between
     cards, so a card shorter than the screen doesn't leave empty space around it */
  .slide { display: grid; place-items: center; padding-block: calc(48 * var(--su, var(--pu))); }
  .slide > * { position: relative; }
  /* cards span the page's content width (104 design px margins, like every section); only their height fits the screen */
  .falcon, .swad, .story { width: calc(1520 * var(--pu)) !important; }

  /* the first slide carries the labels: "kaam" sits right on the Falcon card's top edge */
  .slide--first { padding-top: calc(48 * var(--su, var(--pu)) + 150 * var(--su, var(--pu))); }
  .slide__stack { position: relative; }
  /* each card fits the screen below the sticky nav, with 4% of the screen above and below it */
  .work { --room: calc(92svh - var(--nav-h)); }
  /* the cards share the page's one type scale (--su, styles/home.css), which already fits the tallest card below the nav */
  .falcon, .swad, .story { --u: var(--su, min(1px, calc(var(--vw, 100vw) / 1728))); }

  /* the whole card opens its case study (the Read More link stays the real, focusable link) */
  .falcon, .swad, .story { cursor: pointer; translate: 0 0; transition: translate .5s cubic-bezier(.2, .7, .2, 1); }
  .falcon:hover, .swad:hover, .story:hover { translate: 0 -6px; }
  .falcon:hover .case__more, .swad:hover .case__more { color: var(--accent); }
  .story:hover .case__more { text-decoration-thickness: 2px; }
  .case__more::after { content: ' →'; display: inline-block; transition: transform .4s cubic-bezier(.2, .7, .2, 1); }
  .falcon:hover .case__more::after, .swad:hover .case__more::after, .story:hover .case__more::after { transform: translateX(6px); }

  /* ---- labels (362:37, 362:38) ---- */
  .work__word { position: absolute; right: calc(-1 * var(--pu)); bottom: 100%; margin-bottom: -0.128em; z-index: 2;   /* in front of the card: the foot of the letters rests exactly on its top edge */
    font-size: calc(200 * var(--su, var(--pu))); line-height: 1; color: var(--accent); white-space: nowrap; text-shadow: none; }
  .work__label { position: absolute; left: 0; bottom: calc(100% + 35 * var(--su, var(--pu))); font-size: max(12px, calc(16 * var(--su, var(--pu)))); font-weight: 400; }

  /* ---- the case-study text block, shared by all three cards (517px column) ---- */
  .case__meta { display: flex; align-items: center; gap: calc(5 * var(--u)); font-size: max(12px, calc(16 * var(--u))); color: var(--muted); }
  /* the dot sits evenly between its words: the same space on both sides */
  .dot { flex: none; width: 4px; height: 4px; border-radius: 50%; background: var(--muted); margin: 0 max(6px, calc(9 * var(--u))); }
  .dot--light { background: var(--paper); }
  .case__title { margin-top: calc(13 * var(--u)); font-size: max(30px, calc(61 * var(--u))); line-height: 1.15; color: var(--ink); }
  .case__title em { color: var(--accent); }
  .case__lede { margin-top: calc(13 * var(--u)); font-size: max(18px, calc(31 * var(--u))); line-height: 1.3; }
  .case__rule { margin: calc(39 * var(--u)) 0; width: calc(489 * var(--u)); max-width: 100%; height: 0; border: 0; border-top: 1px solid currentColor; }
  /* the same three facts on every card: the outcome across the top, then company and role side by side */
  .case__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(26 * var(--u)) calc(26 * var(--u)); width: calc(483 * var(--u)); max-width: 100%; }
  .case__outcome { grid-column: 1 / -1; }
  .case__facts dt { font-size: max(12px, calc(16 * var(--u))); font-style: italic; color: var(--muted); margin-bottom: calc(6.5 * var(--u)); }
  .case__facts dd { font-size: max(14px, calc(20 * var(--u))); line-height: 1.5; }
  .case__links { display: flex; align-items: center; gap: calc(43 * var(--u)); margin-top: calc(39 * var(--u)); }
  .case__more { font-size: max(16px, calc(25 * var(--u))); font-weight: 500; text-decoration: underline; text-decoration-thickness: from-font;
    text-underline-position: from-font; transition: color .3s ease; }
  .case__paper { display: inline-flex; align-items: center; gap: calc(7 * var(--u)); font-size: max(14px, calc(20 * var(--u))); line-height: 1.5; transition: color .3s ease; }
  .case__paper img { width: calc(8 * var(--u)); }
  .case__more:hover, .case__paper:hover { color: var(--accent); }

  /* ---- Falcon: a black card, the film on the left with its edges melting into the card, the case on the right ---- */
  .falcon { width: calc(1520 * var(--u)); padding: calc(52 * var(--u)) !important; border-radius: var(--radius); color: var(--paper); overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 1fr) calc(500 * var(--u)); column-gap: calc(72 * var(--u)); align-items: center;
    /* the site's black, with the resume button's red (--grad-resume) glowing in from two corners only */
    background:
      radial-gradient(42% 70% at 100% 0%, #2d0a05 0%, rgba(45, 10, 5, .55) 38%, rgba(45, 10, 5, 0) 72%),
      radial-gradient(38% 65% at 0% 100%, #2d0a05 0%, rgba(45, 10, 5, .5) 36%, rgba(45, 10, 5, 0) 70%),
      #0f0e0c;   /* the site's ink, written out: the living light warms var(--ink) on lit cards */
    box-shadow: var(--shadow-big); }
  .falcon__film { position: relative; min-width: 0; }
  /* each client's mark, small, in its card's top-left corner (Diviniti's in paper, over its dark photograph) */
  :global(.card-logo) { position: absolute; left: calc(36 * var(--u)); top: calc(30 * var(--u)); z-index: 2; height: auto; pointer-events: none; }
  /* Swad's mark sits over the café itself, larger, as on its own covers: centred over the light wall at the top */
  .swad__visual :global(.swad__logo) { position: absolute; left: 50%; top: 7%; z-index: 1; width: max(140px, calc(250 * var(--u))); height: auto; translate: -50% 0;
    filter: drop-shadow(0 2px 10px rgba(255, 248, 235, .55)); pointer-events: none; }
  :global(.card-logo--diviniti) { width: max(70px, calc(104 * var(--u))); filter: brightness(0) invert(1); opacity: .92; }
  /* the client's mark, small, in the card's top-left corner */
  .falcon :global(.falcon__logo) { position: absolute; left: calc(30 * var(--u)); top: calc(26 * var(--u)); z-index: 2; width: max(30px, calc(46 * var(--u))); height: auto; pointer-events: none; }
  .falcon__video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #0f0e0c;
    /* the film's ground is the card's: its edges fade into it rather than stopping at a frame */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent), linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent), linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
    mask-composite: intersect; }
  .falcon__play { position: absolute; left: 50%; top: 50%; z-index: 3; translate: -50% -50%; display: grid; place-items: center;
    width: 64px; height: 64px; padding: 0; border: 1px solid rgba(248, 247, 240, .35); border-radius: 50%; cursor: pointer;
    background: rgba(15, 14, 12, .62); color: #f8f7f0; transition: background-color .2s ease, opacity .3s ease; }
  .falcon__play[hidden] { display: none; }
  .falcon__play:hover { background: rgba(15, 14, 12, .82); }
  .falcon__play:focus-visible { outline: 2px solid #f8f7f0; outline-offset: 3px; }
  .falcon__play svg { width: 26px; height: 26px; fill: currentColor; }
  .falcon__play .i-pause, .falcon__play.is-playing .i-play { display: none; }
  .falcon__play.is-playing .i-pause { display: inline; }
  /* while it plays, the pause button keeps out of the way until the film is hovered or the button focused */
  .falcon__play.is-playing { opacity: 0; }
  .falcon__film:hover .falcon__play.is-playing, .falcon__play.is-playing:focus-visible { opacity: 1; }
  /* lite: the same soft edges, painted in the card's black over the film rather than masked out of it (global.css) */
  :global(html.lite) .falcon__video { -webkit-mask-image: none; mask-image: none; }
  :global(html.lite) .falcon__film::after { content: ''; position: absolute; inset: -1px; z-index: 1; pointer-events: none;
    background: linear-gradient(to right, #0f0e0c, rgba(15, 14, 12, 0) 9%, rgba(15, 14, 12, 0) 91%, #0f0e0c),
      linear-gradient(to bottom, #0f0e0c, rgba(15, 14, 12, 0) 10%, rgba(15, 14, 12, 0) 90%, #0f0e0c); }
  .falcon .falcon__case { position: relative; width: auto; margin: 0; }
  /* on the night card: slightly tighter type, so the case sits level with the film; the accent in the site's red */
  .falcon .case__meta, .falcon .case__facts dt { color: rgba(252, 251, 248, .6); }
  .falcon .case__title { font-size: max(30px, calc(54 * var(--u))); }
  .falcon .falcon__case .case__title em { color: var(--accent); }   /* the site's red, as on the other cards */
  .falcon .case__lede { font-size: max(17px, calc(25 * var(--u))); color: rgba(252, 251, 248, .86); }
  .falcon .case__rule { margin: calc(30 * var(--u)) 0; opacity: .28; }
  .falcon .case__facts { width: 100%; gap: calc(22 * var(--u)); }
  .falcon .case__links { margin-top: calc(32 * var(--u)); }
  .falcon:hover .case__more { color: var(--accent) !important; }

  /* ---- Swad (362:102 dark card, 362:103 plate, 362:104 text card) ---- */
  .swad { width: calc(1520 * var(--u)); min-height: calc(986 * var(--u)); display: grid; grid-template-columns: 1fr 1fr; column-gap: 1.72%; }
  .swad__visual, .swad__body { position: relative; border-radius: var(--radius); }
  .swad__visual { background: var(--ink); box-shadow: var(--shadow-big); overflow: hidden; --cut: 50%; }
  /* before / after */
  .swad__before { position: absolute; inset: 0; z-index: 2; clip-path: inset(0 calc(100% - var(--cut)) 0 0); }
  .swad__before img { width: 100%; height: 100%; object-fit: cover; object-position: 55% 50%; display: block; }
  .swad__divider { position: absolute; top: 0; bottom: 0; left: var(--cut); z-index: 3; width: 0; border-left: 1.5px solid rgba(252, 251, 248, .9); pointer-events: none;
    box-shadow: 0 0 12px rgba(0, 0, 0, .35); }
  .swad__divider i { position: absolute; left: 50%; top: 50%; width: 44px; height: 44px; translate: -50% -50%; border-radius: 50%; background: var(--paper);
    box-shadow: 0 6px 18px rgba(15, 14, 12, .3); transition: scale .25s cubic-bezier(.2, .7, .2, 1); }
  /* the grip: two small chevrons, pointing apart */
  .swad__divider i::before, .swad__divider i::after { content: ''; position: absolute; top: 50%; width: 7px; height: 7px; border: solid var(--ink); border-width: 1.5px 1.5px 0 0; }
  .swad__divider i::before { left: 12px; transform: translateY(-50%) rotate(-135deg); }
  .swad__divider i::after { right: 12px; transform: translateY(-50%) rotate(45deg); }
  .swad__visual:hover .swad__divider i, .swad__range:focus-visible ~ .swad__divider i { scale: 1.08; }
  .swad__tag { position: absolute; bottom: calc(22 * var(--u)); z-index: 3; padding: 5px 10px; border-radius: 99px; background: rgba(15, 14, 12, .62); color: var(--paper);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; pointer-events: none; }
  .swad__tag--before { left: calc(22 * var(--u)); }
  .swad__tag--after { right: calc(22 * var(--u)); }
  .swad__range { position: absolute; inset: 0; z-index: 4; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; -webkit-appearance: none; appearance: none; touch-action: pan-y; }
  .swad__range:focus-visible { opacity: 0; }
  .swad__visual:has(.swad__range:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .swad__plate { position: absolute; inset: 0; width: 100%; height: 100%;   /* the photo fills the whole panel */
    border-radius: inherit; background: var(--grad-swad); object-fit: cover; }
  .swad__body { background: var(--white); filter: var(--drop-big, drop-shadow(-20px 20px 13px rgba(0, 0, 0, 0.08)));
    padding: calc(92 * var(--u)) calc(101 * var(--u)) calc(86 * var(--u)) calc(129 * var(--u)); }
  .swad__body > * { max-width: max(calc(517 * var(--u)), 82%); }

  /* ---- Redefining Design (362:74) ---- */
