---
// Section 2 — kaam (curated works). Figma: 362:37/38 (labels), 362:39 + 362:42 (Falcon), 362:74 (Redefining Design),
// 362:102–362:104 (Swad). The section starts at design y 1074; coordinates below are relative to that.
import { Image } from 'astro:assets';
import diviniti from '../assets/home/diviniti-cover.png';
---
<section class="work" id="work" aria-labelledby="work-title">

  <!-- Falcon: a night card around the film of the case study (components/FalconFilm.astro, exported as an MP4 by
       scripts/falcon-film-export.ts). The film loops seamlessly. -->
  <div class="slide slide--first">
  <div class="slide__stack">
  <h2 class="work__word t-display" id="work-title">kaam</h2>
  <p class="work__label">CURATED WORKS</p>
  <article class="falcon" data-reveal>
    <div class="falcon__film">
      <video class="falcon__video" data-falcon-cover src="/media/falcon-film.mp4" poster="/media/falcon-film-poster.jpg" muted loop playsinline preload="metadata"
        aria-label="Falcon in motion: five disconnected data sources resolve into three root causes, then into the redesigned Falcon dashboard."></video>
    </div>
    <div class="case case--light falcon__case">
      <p class="case__meta">FALCON · VI SNOC <span class="dot dot--light"></span>2026</p>
      <h3 class="case__title t-serif">Making millions of network events explain a <em>single outage.</em></h3>
      <p class="case__lede">A network operations dashboard, redesigned for the moments when every minute of downtime counts.</p>
      <hr class="case__rule" />
      <dl class="case__facts">
        <div class="case__outcome"><dt>Outcome</dt><dd>Evidence for an outage correlated in under 10 seconds, down from a minute</dd></div>
        <div><dt>Company</dt><dd>Vodafone Idea</dd></div>
        <div><dt>Role</dt><dd>Product design intern</dd></div>
      </dl>
      <div class="case__links"><a class="case__more" href="/work/falcon">Read More</a></div>
    </div>
  </article>
  </div>
  </div>

  <!-- Swad: a dark visual card beside a white text card -->
  <div class="slide">
  <div class="swad">
    <div class="swad__visual" style="view-transition-name: vt-swad" data-reveal aria-hidden="true"><img class="swad__plate" src="/work/swad/photos/hero.webp" alt="" loading="lazy" /></div>
    <article class="swad__body case" data-reveal>
      <p class="case__meta">SWAD · MOMO CAFÉ <span class="dot"></span>2026</p>
      <h3 class="case__title t-serif">How a momo café that couldn’t make rent <em>found its regulars.</em></h3>
      <p class="case__lede">A quiet-lane café in Ranchi went from losing ₹10,000 a month to ₹20,000 in profit in six months.</p>
      <hr class="case__rule" />
      <dl class="case__facts">
        <div class="case__outcome"><dt>Outcome</dt><dd>−₹10,000 to +₹20,000 a month, about 8 in 10 orders from regulars</dd></div>
        <div><dt>Company</dt><dd>Swad, a family-owned café</dd></div>
        <div><dt>Role</dt><dd>Product manager</dd></div>
      </dl>
      <div class="case__links"><a class="case__more" href="/work/swad">Read More</a></div>
    </article>
  </div>
  </div>

  <!-- Redefining Design: a full-width image card -->
  <div class="slide">
  <article class="story case case--light" data-reveal>
    <div class="story__bg" style="view-transition-name: vt-diviniti"><Image src={diviniti} alt="" widths={[768, 1280, 1774]} sizes="(max-width: 900px) 100vw, 1520px" data-parallax="6" /></div>
    <div class="story__body">
      <p class="case__meta">DIVINITI · E&#8209;COMMERCE <span class="dot dot--light"></span>2025–26</p>
      <h3 class="case__title t-serif">A year that took my design from <em>pixels to platforms.</em></h3>
      <p class="case__lede">From lighting product images by hand to the product data behind the site, its marketplaces and its AI.</p>
      <hr class="case__rule" />
      <dl class="case__facts">
        <div class="case__outcome"><dt>Outcome</dt><dd>Portrait on Gold and the chatbot Amy, both live and in use</dd></div>
        <div><dt>Company</dt><dd>Diviniti India</dd></div>
        <div><dt>Role</dt><dd>Design intern, then Founder’s Office</dd></div>
      </dl>
      <div class="case__links"><a class="case__more" href="/work/diviniti">Read More</a></div>
    </div>
  </article>
  </div>
</section>

<script>
  // the Falcon film plays only while its card is on screen (and not at all for reduced motion: its poster stays)
  const film = document.querySelector<HTMLVideoElement>('[data-falcon-cover]');
  if (film && !matchMedia('(prefers-reduced-motion: reduce)').matches) new IntersectionObserver(([e]) => {
    if (e.isIntersecting) film.play().catch(() => {}); else film.pause();
  }, { threshold: 0.25 }).observe(film);

  // a click anywhere on a project card opens its case study, unless it was on another link or selected some text;
  // ctrl / ⌘ click opens it in a new tab, as a link would
  document.querySelectorAll<HTMLElement>('.falcon, .swad, .story').forEach(card => {
    const link = card.querySelector<HTMLAnchorElement>('.case__more');
    if (!link) return;
    card.addEventListener('click', e => {
      if ((e.target as Element).closest('a') || getSelection()?.toString()) return;
      if (e.metaKey || e.ctrlKey) window.open(link.href, '_blank');
      else link.click();
    });
  });
</script>

<style>
  /* --pu: the page's design pixel (cards redefine --u for their own height-fitted scale) */
  .work { position: relative; --pu: var(--u); }

  /* one card per slide, each fitted to the screen (its own --u). Slides hug their cards: a fixed 96 design px between
     cards, so a card shorter than the screen doesn't leave empty space around it */
  .slide { display: grid; place-items: center; padding-block: calc(48 * var(--su, var(--pu))); }
  .slide > * { position: relative; }
  /* cards span the page's content width (104 design px margins, like every section); only their height fits the screen */
  .falcon, .swad, .story { width: calc(1520 * var(--pu)) !important; }

  /* the first slide carries the labels: "kaam" sits right on the Falcon card's top edge */
  .slide--first { padding-top: calc(48 * var(--su, var(--pu)) + 150 * var(--su, var(--pu))); }
  .slide__stack { position: relative; }
  /* each card fits the screen below the sticky nav, with 4% of the screen above and below it */
  .work { --room: calc(92svh - var(--nav-h)); }
  /* the cards share the page's one type scale (--su, styles/home.css), which already fits the tallest card below the nav */
  .falcon, .swad, .story { --u: var(--su, min(1px, calc(var(--vw, 100vw) / 1728))); }

  /* the whole card opens its case study (the Read More link stays the real, focusable link) */
  .falcon, .swad, .story { cursor: pointer; translate: 0 0; transition: translate .5s cubic-bezier(.2, .7, .2, 1); }
  .falcon:hover, .swad:hover, .story:hover { translate: 0 -6px; }
  .falcon:hover .case__more, .swad:hover .case__more { color: var(--accent); }
  .story:hover .case__more { text-decoration-thickness: 2px; }
  .case__more::after { content: ' →'; display: inline-block; transition: transform .4s cubic-bezier(.2, .7, .2, 1); }
  .falcon:hover .case__more::after, .swad:hover .case__more::after, .story:hover .case__more::after { transform: translateX(6px); }

  /* ---- labels (362:37, 362:38) ---- */
  .work__word { position: absolute; right: calc(-1 * var(--pu)); bottom: 100%; margin-bottom: -0.128em; z-index: 2;   /* in front of the card: the foot of the letters rests exactly on its top edge */
    font-size: calc(200 * var(--su, var(--pu))); line-height: 1; color: var(--accent); white-space: nowrap; text-shadow: none; }
  .work__label { position: absolute; left: 0; bottom: calc(100% + 35 * var(--su, var(--pu))); font-size: max(12px, calc(16 * var(--su, var(--pu)))); font-weight: 400; }

  /* ---- the case-study text block, shared by all three cards (517px column) ---- */
  .case__meta { display: flex; align-items: center; gap: calc(5 * var(--u)); font-size: max(12px, calc(16 * var(--u))); color: var(--muted); }
  /* the dot sits evenly between its words: the same space on both sides */
  .dot { flex: none; width: 4px; height: 4px; border-radius: 50%; background: var(--muted); margin: 0 max(6px, calc(9 * var(--u))); }
  .dot--light { background: var(--paper); }
  .case__title { margin-top: calc(13 * var(--u)); font-size: max(30px, calc(61 * var(--u))); line-height: 1.15; color: var(--ink); }
  .case__title em { color: var(--accent); }
  .case__lede { margin-top: calc(13 * var(--u)); font-size: max(18px, calc(31 * var(--u))); line-height: 1.3; }
  .case__rule { margin: calc(39 * var(--u)) 0; width: calc(489 * var(--u)); max-width: 100%; height: 0; border: 0; border-top: 1px solid currentColor; }
  /* the same three facts on every card: the outcome across the top, then company and role side by side */
  .case__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(26 * var(--u)) calc(26 * var(--u)); width: calc(483 * var(--u)); max-width: 100%; }
  .case__outcome { grid-column: 1 / -1; }
  .case__facts dt { font-size: max(12px, calc(16 * var(--u))); font-style: italic; color: var(--muted); margin-bottom: calc(6.5 * var(--u)); }
  .case__facts dd { font-size: max(14px, calc(20 * var(--u))); line-height: 1.5; }
  .case__links { display: flex; align-items: center; gap: calc(43 * var(--u)); margin-top: calc(39 * var(--u)); }
  .case__more { font-size: max(16px, calc(25 * var(--u))); font-weight: 500; text-decoration: underline; text-decoration-thickness: from-font;
    text-underline-position: from-font; transition: color .3s ease; }
  .case__paper { display: inline-flex; align-items: center; gap: calc(7 * var(--u)); font-size: max(14px, calc(20 * var(--u))); line-height: 1.5; transition: color .3s ease; }
  .case__paper img { width: calc(8 * var(--u)); }
  .case__more:hover, .case__paper:hover { color: var(--accent); }

  /* ---- Falcon: a black card, the film on the left with its edges melting into the card, the case on the right ---- */
  .falcon { width: calc(1520 * var(--u)); padding: calc(52 * var(--u)) !important; border-radius: var(--radius); color: var(--paper); overflow: hidden;
    display: grid; grid-template-columns: minmax(0, 1fr) calc(500 * var(--u)); column-gap: calc(72 * var(--u)); align-items: center;
    /* the site's black, with the resume button's red (--grad-resume) glowing in from two corners only */
    background:
      radial-gradient(42% 70% at 100% 0%, #2d0a05 0%, rgba(45, 10, 5, .55) 38%, rgba(45, 10, 5, 0) 72%),
      radial-gradient(38% 65% at 0% 100%, #2d0a05 0%, rgba(45, 10, 5, .5) 36%, rgba(45, 10, 5, 0) 70%),
      #0f0e0c;   /* the site's ink, written out: the living light warms var(--ink) on lit cards */
    box-shadow: var(--shadow-big); }
  .falcon__film { position: relative; min-width: 0; }
  .falcon__video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #0f0e0c;
    /* the film's ground is the card's: its edges fade into it rather than stopping at a frame */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent), linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 9%, #000 91%, transparent), linear-gradient(to bottom, transparent, #000 10%, #000 90%, transparent);
    mask-composite: intersect; }
  .falcon .falcon__case { position: relative; width: auto; margin: 0; }
  /* on the night card: slightly tighter type, so the case sits level with the film; the accent in the site's red */
  .falcon .case__meta, .falcon .case__facts dt { color: rgba(252, 251, 248, .6); }
  .falcon .case__title { font-size: max(30px, calc(54 * var(--u))); }
  .falcon .falcon__case .case__title em { color: var(--accent); }   /* the site's red, as on the other cards */
  .falcon .case__lede { font-size: max(17px, calc(25 * var(--u))); color: rgba(252, 251, 248, .86); }
  .falcon .case__rule { margin: calc(30 * var(--u)) 0; opacity: .28; }
  .falcon .case__facts { width: 100%; gap: calc(22 * var(--u)); }
  .falcon .case__links { margin-top: calc(32 * var(--u)); }
  .falcon:hover .case__more { color: var(--accent) !important; }

  /* ---- Swad (362:102 dark card, 362:103 plate, 362:104 text card) ---- */
  .swad { width: calc(1520 * var(--u)); min-height: calc(986 * var(--u)); display: grid; grid-template-columns: 1fr 1fr; column-gap: 1.72%; }
  .swad__visual, .swad__body { position: relative; border-radius: var(--radius); }
  .swad__visual { background: var(--ink); box-shadow: var(--shadow-big); overflow: hidden; }
  .swad__plate { position: absolute; inset: 0; width: 100%; height: 100%;   /* the photo fills the whole panel */
    border-radius: inherit; background: var(--grad-swad); object-fit: cover; }
  .swad__body { background: var(--white); filter: var(--drop-big, drop-shadow(-20px 20px 13px rgba(0, 0, 0, 0.08)));
    padding: calc(92 * var(--u)) calc(101 * var(--u)) calc(86 * var(--u)) calc(129 * var(--u)); }
  .swad__body > * { max-width: max(calc(517 * var(--u)), 82%); }

  /* ---- Redefining Design (362:74) ---- */
  .story { width: calc(1520 * var(--u)); min-height: calc(915 * var(--u)); padding-bottom: calc(60 * var(--u)) !important;
    border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-big); color: var(--paper);
    padding: calc(140 * var(--u)) 0 0 calc(129 * var(--u)); }
  .story__bg { position: absolute; inset: 0; }
  /* 8% spare above and below (top is a share of the card's height; a % margin would be a share of its width), so the
     ±6% parallax drift never shows the card's edge */
  .story__bg :global(img) { position: absolute; left: 0; top: -8%; width: 100%; height: 116%; object-fit: cover; }
  .story::after { content: ''; position: absolute; inset: 0; background: var(--grad-story); pointer-events: none; }
  .story__body { position: relative; z-index: 1; width: max(calc(517 * var(--u)), 36%); }
  .case--light .case__meta, .case--light .case__facts dt, .case--light .case__title, .case--light .case__title em { color: var(--paper); }

  /* ---- phones and small tablets ---- */
  @media (max-width: 900px) {
    .work { height: auto; padding: 72px 20px 0; display: flex; flex-direction: column; gap: 24px; }
    .slide__stack { display: flex; flex-direction: column; gap: 24px; }
    .falcon, .swad, .story { width: auto !important; }
    .slide--first { padding-top: 0; }
    .slide > *, .slide__stack > * { position: relative; left: auto; top: auto; width: auto; height: auto; }
    .slide { min-height: 0; padding: 0; display: block; }
    .work__word { position: static; align-self: flex-end; font-size: clamp(72px, 23vw, 104px); margin: 2px -2px -0.2em 0; }
    .work__label { position: static; order: -1; margin: 0; font-size: 12px; letter-spacing: .06em; }   /* above "kaam", not on its line */
    .case__title { font-size: 34px; }
    .case__lede { font-size: 20px; }
    .case__facts { grid-template-columns: 1fr 1fr; width: auto; gap: 20px; }
    .dot { margin: 0 6px; }
    /* phones: the film across the top of the card, the case below it */
    .falcon { grid-template-columns: 1fr; row-gap: 28px; padding: 12px 12px 32px !important; }
    .falcon .falcon__case { padding: 0 8px; }
    .swad { display: flex; flex-direction: column; gap: 20px; min-height: 0; }
    .falcon, .story { min-height: 0; }
    .swad__visual, .swad__body { position: relative; left: auto; width: auto; height: auto; }
    .swad__visual { aspect-ratio: 4 / 3; }
    .swad__body { padding: 32px 20px; }
    .swad__body > * { max-width: none; }
    .story { padding: 40px 20px; min-height: 480px; }
    .story::after { background: linear-gradient(to bottom, rgba(15, 13, 10, .8), rgba(15, 13, 10, .35)); }
    .story__body { width: auto; }
  }

  @media (max-width: 900px) { .case__more { display: inline-block; padding: 11px 0; } }
  /* tablets: picture and story side by side on the Falcon and Swad cards, so a card fits the screen */
  @media (min-width: 601px) and (max-width: 900px) {
    .work { padding-left: 40px; padding-right: 40px; gap: 28px; }
    .slide__stack { gap: 28px; }
    .falcon { padding: 20px 20px 40px !important; row-gap: 32px; }
    .falcon .falcon__case { padding: 0 12px; max-width: 620px; }
    .swad { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .swad__visual { aspect-ratio: auto; min-height: 100%; }
    .swad__body { padding: 40px 32px; }
    .story { padding: 56px 40px; min-height: 520px; }
    .story__body { max-width: 62%; }
    .story::after { background: var(--grad-story); }
    .case__title { font-size: 36px; }
  }
</style>
