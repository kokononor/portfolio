---
// Section 3: deewaar (wall). The poster work, after the case studies: one row of posters that slides on its own
// (public/posters, converted from the originals at 720 and 1600 wide), each opening full size in a lightbox. The row
// is a real scroller, so it can also be swiped or dragged; the set is printed twice so the slide loops without a seam. Behance and Instagram
// carry the rest. Cosmic Papercraft is left out on purpose: it prints two organisers' phone numbers.
const posters = [
  { id: 'devdas', title: 'Devdas', w: 2480, h: 3508 },
  { id: 'eyes-dont-lie', title: 'The Eyes Don’t Lie', w: 1080, h: 1350 },
  { id: 'karma', title: 'Karma', w: 2480, h: 3508 },
  { id: 'witcher', title: 'White Wolf', w: 2480, h: 3508 },
  { id: 'crow', title: 'Crow', w: 1080, h: 1080 },
  { id: 'euphoria', title: 'Euphoria', w: 2480, h: 3508 },
  { id: 'short-money', title: 'Short Money', w: 2480, h: 3508 },
  { id: 'ferrari', title: 'Ferrari', w: 1080, h: 1080 },
  { id: 'hollow', title: 'Hollow', w: 1080, h: 1350 },
  { id: 'detective', title: 'Detective', w: 1080, h: 1080 },
  { id: 'eternal-lies', title: 'Eternal Lies', w: 1080, h: 1080 },
  { id: 'no-name', title: 'Flight Risk', w: 2480, h: 3508 },
  { id: 'cherry', title: 'Cherry', w: 1080, h: 1350 },
  { id: 'happy-new-year', title: 'Happy New Year', w: 1080, h: 1920 },
  { id: 'orientation', title: 'Orientation', w: 1080, h: 1080 },
  { id: 'recruitment', title: 'Recruitment', w: 1080, h: 1080 },
];
const src = (id: string, size: 720 | 1600) => `/posters/${id}-${size}.webp`;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="posters" id="posters" aria-labelledby="posters-title">
  <header class="posters__head">
    <h2 class="posters__word t-display" id="posters-title">deewaar</h2>
  </header>

  <div class="posters__rail" data-rail>
    <ul class="posters__track">
      {[0, 1].map(copy => posters.map((p, i) => (
        <li aria-hidden={copy ? 'true' : undefined}>
          <button class="poster" type="button" data-poster={i} data-full={src(p.id, 1600)} data-title={p.title} tabindex={copy ? -1 : undefined}
            aria-label={`Open ${p.title} full size`} data-cursor="View" style={`--ar: ${p.w} / ${p.h};`}>
            <img src={src(p.id, 720)} alt={copy ? '' : `${p.title}, a poster by Suyash`} width="720" height={Math.round(720 * p.h / p.w)} loading="lazy" decoding="async" draggable="false" />
            <span class="poster__cap"><span>{pad(i + 1)}</span>{p.title}</span>
          </button>
        </li>
      )))}
    </ul>
  </div>

  <footer class="posters__more">
    <div>
      <a href="https://www.behance.net/gallery/214238477/Poster-Collection-2024" target="_blank" rel="noopener">Behance <span aria-hidden="true">↗</span></a>
      <a href="https://www.instagram.com/notfiguredyet/" target="_blank" rel="noopener">Instagram @notfiguredyet <span aria-hidden="true">↗</span></a>
    </div>
  </footer>

  <dialog class="viewer" data-viewer aria-label="Poster">
    <button class="viewer__close" type="button" data-viewer-close>Close ✕</button>
    <button class="viewer__nav viewer__nav--prev" type="button" data-viewer-step="-1" aria-label="Previous poster">←</button>
    <figure class="viewer__fig">
      <img data-viewer-img alt="" />
      <figcaption data-viewer-cap></figcaption>
    </figure>
    <button class="viewer__nav viewer__nav--next" type="button" data-viewer-step="1" aria-label="Next poster">→</button>
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-viewer]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-poster]')];
  const items = buttons.filter(b => b.tabIndex !== -1);
  const img = dialog?.querySelector<HTMLImageElement>('[data-viewer-img]');
  const cap = dialog?.querySelector<HTMLElement>('[data-viewer-cap]');
  let at = 0;
  const show = (i: number) => {
    at = (i + items.length) % items.length;
    const b = items[at];
    if (!img || !cap) return;
    img.src = b.dataset.full!;
    img.alt = `${b.dataset.title}, a poster by Suyash`;
    cap.textContent = `${String(at + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')} · ${b.dataset.title}`;
  };
  let dragged = false;
  buttons.forEach(b => b.addEventListener('click', () => {
    if (!dialog || dragged) return;
    show(Number(b.dataset.poster));
    dialog.showModal();
    (window as any).__lenis?.stop();
  }));
  dialog?.querySelectorAll<HTMLButtonElement>('[data-viewer-step]').forEach(b => b.addEventListener('click', () => show(at + Number(b.dataset.viewerStep))));
  dialog?.querySelector('[data-viewer-close]')?.addEventListener('click', () => dialog.close());
  // a click on the dark ground (not the poster or a button) closes it
  dialog?.addEventListener('click', e => { if (e.target === dialog || (e.target as Element).classList.contains('viewer__fig')) dialog.close(); });
  dialog?.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight') show(at + 1);
    if (e.key === 'ArrowLeft') show(at - 1);
  });
  dialog?.addEventListener('close', () => { (window as any).__lenis?.start(); items[at]?.focus({ preventScroll: true }); });

  // ---- the row slides on its own: a steady drift, paused on hover, focus, while the viewer is open, off screen, or
  // for a moment after the visitor swipes, drags or scrolls it. With reduced motion it only moves when moved. ----
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  if (rail) {
    const track = rail.firstElementChild as HTMLElement;
    const SPEED = 40;                                            // px a second
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pos = 0, last = 0, onScreen = false, hover = false, restUntil = 0, ours = false;
    const half = () => track.scrollWidth / 2;                    // one copy of the set
    const wrap = () => { const h = half(); if (pos >= h) pos -= h; if (pos < 0) pos += h; };
    const rest = (ms = 2500) => { restUntil = performance.now() + ms; };
    // the dynamics: scrolling the page pushes the row (it speeds up, then eases back) and leans the posters into the
    // motion; and the row bows into a shallow arc, the poster in the middle lifted and square, the ones at the ends
    // sunk and turned, so posters rise and settle as they pass through.
    const cells = [...track.children] as HTMLElement[];
    let centres: number[] = [];
    const measure = () => { centres = cells.map(c => c.offsetLeft + c.offsetWidth / 2); };
    measure();
    addEventListener('resize', measure);
    addEventListener('load', measure);
    let lastY = scrollY, boost = 0, lean = 0;
    const arc = () => {
      const mid = rail.scrollLeft + rail.clientWidth / 2, reach = rail.clientWidth * 0.62;
      cells.forEach((c, i) => {
        const d = Math.max(-1, Math.min(1, (centres[i] - mid) / reach));   // -1 left edge, 0 centre, 1 right edge
        c.style.transform = `translateY(${(d * d * 24).toFixed(1)}px) rotate(${(d * 3.2).toFixed(2)}deg) scale(${(1 - d * d * 0.07).toFixed(3)}) skewX(${lean.toFixed(2)}deg)`;
      });
    };
    const tick = (t: number) => {
      const dt = last ? Math.min(64, t - last) / 1000 : 0;
      last = t;
      const dy = scrollY - lastY; lastY = scrollY;
      if (!still) {
        boost = Math.min(900, boost * 0.92 + Math.abs(dy) * 6);
        lean += (Math.max(-6, Math.min(6, -dy * 0.25)) - lean) * 0.12;
      }
      if (onScreen && !hover && !dialog?.open && t > restUntil && !still) {
        pos += (SPEED + boost) * dt; wrap();
        ours = true; rail.scrollLeft = pos;
      }
      if (!still) arc();
      if (onScreen) requestAnimationFrame(tick); else last = 0;
    };
    // the visitor's own scrolling (swipe, trackpad, keys) takes over, and the loop still wraps
    rail.addEventListener('scroll', () => {
      if (ours) { ours = false; return; }
      pos = rail.scrollLeft; const before = pos; wrap();
      if (pos !== before) rail.scrollLeft = pos;
      rest();
    }, { passive: true });
    rail.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') hover = true; });
    rail.addEventListener('pointerleave', () => { hover = false; });
    rail.addEventListener('focusin', () => { hover = true; });
    rail.addEventListener('focusout', () => { hover = false; });
    rail.addEventListener('touchstart', () => rest(4000), { passive: true });
    // dragging with a mouse
    let downX = 0, startPos = 0, down = false;
    rail.addEventListener('pointerdown', e => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true; dragged = false; downX = e.clientX; startPos = rail.scrollLeft;
    });
    addEventListener('pointermove', e => {
      if (!down) return;
      const dx = e.clientX - downX;
      if (Math.abs(dx) > 6) { dragged = true; rail.classList.add('is-dragging'); }
      if (dragged) rail.scrollLeft = startPos - dx;
    });
    addEventListener('pointerup', () => {
      if (!down) return;
      down = false; rail.classList.remove('is-dragging');
      setTimeout(() => { dragged = false; }, 0);                 // the click that ends a drag opens nothing
    });
    new IntersectionObserver(([e]) => {
      const was = onScreen; onScreen = e.isIntersecting;
      if (onScreen && !was) requestAnimationFrame(tick);
    }).observe(rail);
  }
</script>

<style>
  .posters { position: relative; padding: calc(150 * var(--u)) calc(104 * var(--u)) 0; }

  /* the head: only the big red word, as kaam and parichay */
  .posters__head { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: end; column-gap: calc(96 * var(--u)); }
  .posters__word { margin: 0; font-size: calc(200 * var(--u)); line-height: 1; color: var(--accent); white-space: nowrap; }

  /* the row: full page width, its ends fading into the page; a scroller with its bar hidden */
  .posters__rail { margin: calc(64 * var(--u)) calc(-104 * var(--u)) 0; padding: calc(28 * var(--u)) 0 max(36px, calc(52 * var(--u))); overflow-x: auto; overflow-y: hidden;
    scrollbar-width: none; cursor: grab; overscroll-behavior-x: contain;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent); }
  .posters__rail::-webkit-scrollbar { display: none; }
  .posters__rail.is-dragging { cursor: grabbing; }
  .posters__rail.is-dragging .poster { pointer-events: none; }
  .posters__track { display: flex; gap: calc(28 * var(--u)); width: max-content; margin: 0; padding: 0 0 0 calc(28 * var(--u)); list-style: none; }
  .posters__track li { flex: none; transform-origin: 50% 100%; will-change: transform; }
  /* hovering one poster dims the rest, so it steps forward */
  .posters__track .poster { transition: transform .5s cubic-bezier(.2, .7, .2, 1), box-shadow .5s ease, filter .5s ease, opacity .5s ease; }
  .posters__track:has(.poster:hover) .poster:not(:hover) { filter: grayscale(.7) brightness(.85); opacity: .7; }
  .posters__track .poster:hover { transform: translateY(-14px) scale(1.04); box-shadow: -24px 34px 50px rgba(0, 0, 0, .22); }
  .posters__track .poster { height: calc(364 * var(--u)); width: auto; aspect-ratio: var(--ar); }
  .posters__track .poster img { height: 100%; width: 100%; object-fit: cover; user-select: none; -webkit-user-drag: none; }
  .poster { position: relative; display: block; width: 100%; padding: 0; border: 0; background: var(--night); border-radius: 4px; overflow: hidden; cursor: pointer;
    box-shadow: var(--shadow-big); transition: transform .5s cubic-bezier(.2, .7, .2, 1), box-shadow .5s ease; }
  .poster img { display: block; width: 100%; height: auto; transition: transform .8s cubic-bezier(.2, .7, .2, 1), filter .5s ease; }
  .poster__cap { position: absolute; left: 0; right: 0; bottom: 0; display: flex; gap: 10px; align-items: baseline; padding: 40px 16px 14px;
    background: linear-gradient(to top, rgba(15, 14, 12, .85), rgba(15, 14, 12, 0)); color: var(--paper); text-align: left;
    font-family: var(--serif); font-weight: 300; font-size: max(15px, calc(20 * var(--u))); opacity: 0; translate: 0 8px; transition: opacity .4s ease, translate .4s ease; }
  .poster__cap span { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--accent-on-dark); }
  .poster:hover, .poster:focus-visible { transform: translateY(-6px); box-shadow: -24px 28px 40px rgba(0, 0, 0, .16); }
  .poster:hover img, .poster:focus-visible img { transform: scale(1.03); }
  .poster:hover .poster__cap, .poster:focus-visible .poster__cap { opacity: 1; translate: 0 0; }
  .poster:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* the way to the rest */
  .posters__more { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 16px 40px; margin-top: calc(36 * var(--u));
    padding-top: calc(24 * var(--u)); border-top: 1px solid var(--ink); }
  .posters__more p { font-family: var(--serif); font-weight: 300; font-variation-settings: "SOFT" 0, "WONK" 1; font-size: max(18px, calc(25 * var(--u))); }
  .posters__more div { display: flex; flex-wrap: wrap; gap: 12px 40px; }
  .posters__more a { font-size: max(14px, calc(20 * var(--u))); background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .4s ease, color .3s ease; }
  .posters__more a:hover { color: var(--accent); background-size: 100% 1px; }

  /* the lightbox */
  .viewer { width: 100vw; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(15, 14, 12, .94); color: var(--paper); }
  .viewer::backdrop { background: rgba(15, 14, 12, .6); }
  .viewer[open] { display: grid; grid-template-columns: 72px minmax(0, 1fr) 72px; align-items: center; animation: viewer-in .35s ease both; }
  @keyframes viewer-in { from { opacity: 0; } }
  .viewer__fig { margin: 0; height: 100dvh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 64px 0 24px; }
  .viewer__fig img { max-width: 100%; max-height: calc(100dvh - 140px); width: auto; height: auto; object-fit: contain; border-radius: 4px; box-shadow: 0 30px 60px rgba(0, 0, 0, .5); }
  .viewer__fig figcaption { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; opacity: .75; }
  .viewer__close { position: absolute; right: 16px; top: 14px; height: 36px; padding: 0 16px; border: 1px solid rgba(252, 251, 248, .4); border-radius: 18px; background: none; color: inherit; font: inherit; cursor: pointer; }
  .viewer__nav { justify-self: center; width: 48px; height: 48px; border: 1px solid rgba(252, 251, 248, .35); border-radius: 50%; background: none; color: inherit; font-size: 20px; cursor: pointer; transition: background-color .3s ease; }
  .viewer__nav:hover { background: rgba(252, 251, 248, .12); }
  @media (prefers-reduced-motion: reduce) { .poster, .poster img, .poster__cap { transition: none; } .viewer[open] { animation: none; } }

  @media (min-width: 901px) and (max-width: 1199px) { .posters__track .poster { height: 294px; } }
  @media (max-width: 900px) {
    .posters { padding: 88px 20px 0; }
    .posters__head { display: flex; flex-direction: column; align-items: flex-start; gap: 0; }
    .posters__word { font-size: clamp(72px, 23vw, 104px); margin: 2px 0 0 -4px; }
    .posters__rail { margin: 20px -20px 0; padding: 12px 0 34px; }
    .posters__track { gap: 12px; padding-left: 12px; }
    .posters__track .poster { height: 224px; }
    .poster__cap { opacity: 1; translate: 0 0; padding: 28px 10px 8px; font-size: 13px; }
    .poster__cap span { display: none; }
    .posters__more { margin-top: 20px; }
    .viewer[open] { grid-template-columns: 0 minmax(0, 1fr) 0; }
    .viewer__nav { position: absolute; bottom: 20px; width: 44px; height: 44px; }
    .viewer__nav--prev { left: calc(50% - 56px); }
    .viewer__nav--next { left: calc(50% + 12px); }
    .viewer__fig { padding: 60px 12px 84px; }
    .viewer__fig img { max-height: calc(100dvh - 180px); }
  }
  @media (min-width: 601px) and (max-width: 900px) { .posters { padding-left: 40px; padding-right: 40px; } .posters__rail { margin-left: -40px; margin-right: -40px; } }
</style>
