---
// The site's nav (Figma 362:6): brand · links · resume, pinned to the top of the window on every page.
// On the home page it is bare over the hero and takes a frosted ground once the page scrolls; on the project pages
// (`solid`) it has that ground from the start, since their heroes are dark or red. On phones the links live in a
// full-screen menu behind the toggle (scripts/nav.ts).
import arrowDown from '../assets/home/arrow-down.svg?url';

// `read`: on a case study, the switch between its quick read and its detailed read (both pages carry it)
interface Read { quick: string; detailed: string; current: 'quick' | 'detailed'; quickMin: number; detailedMin: number }
interface Props { solid?: boolean; read?: Read }
const { solid = false, read } = Astro.props;
// on the home page the links scroll to their sections and follow the reading; elsewhere they go back to them
const home = !solid;
const to = (id: string) => (home ? `#${id}` : `/#${id}`);
const links = [['work', 'Work'], ['about', 'About'], ['contact', 'Connect']];
---
<nav class:list={['nav', { 'is-stuck': solid }]} aria-label="Main" data-solid={solid ? '' : undefined}>
  <a class="nav__brand" href={home ? '#top' : '/'}>SUYASH</a>
  <div class="nav__links">
    {links.map(([id, label]) => <a href={to(id)} data-section={home ? id : undefined}>{label.toUpperCase()}</a>)}
  </div>
  <div class:list={['nav__end', { 'has-read': read }]}>
    {read && (
      <div class="readmode" role="group" aria-label="Reading length">
        <a href={read.quick} aria-current={read.current === 'quick' ? 'page' : undefined}>Quick<span class="readmode__long">&nbsp;read</span> <small>{read.quickMin} min</small></a>
        <a href={read.detailed} aria-current={read.current === 'detailed' ? 'page' : undefined}>Detailed <small>{read.detailedMin} min</small></a>
      </div>
    )}
    <a class="nav__resume" href="/resume.pdf" download="Suyash-Resume.pdf">RESUME <img src={arrowDown} width="12" height="18" alt="" /></a>
    <!-- phones: the links live in a full-screen menu -->
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open menu"><span></span><span></span></button>
  </div>
</nav>

<!-- the phone menu: big serif links on paper, under the nav bar (outside the nav, whose frosted ground would trap it) -->
<div class="menu" id="menu" hidden>
  <nav class="menu__links" aria-label="Menu">
    {links.map(([id, label], i) => <a href={to(id)} data-section={home ? id : undefined}><small>0{i + 1}</small>{label}</a>)}
  </nav>
  <div class="menu__foot">
    <a href="/resume.pdf" download="Suyash-Resume.pdf">Download Resume</a>
    <p>Product designer, Delhi</p>
  </div>
</div>

<script>
  import '../scripts/nav';
</script>

<style>
  /* It stays pinned to the top of the window. Bare, as in the design, until .is-stuck gives it a frosted paper
     ground and a hairline, so it reads over everything below. */
  nav.nav { --ux: min(1px, calc(var(--vw, 100vw) / 1728));
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    /* the canvas sits at max(0, (100% − 1728)/2) and can run under the scrollbar, so the right edge is measured from its left */
    padding: calc(24 * var(--nav-u)) calc(100% - max(0px, (100% - 1728 * var(--ux)) / 2) - 1624 * var(--ux))
      calc(18 * var(--nav-u)) calc(max(0px, (100% - 1728 * var(--ux)) / 2) + 104 * var(--ux));
    display: flex; align-items: center; justify-content: space-between; color: var(--ink);
    border-bottom: 0.5px solid transparent;
    transition: background-color .4s ease, border-color .4s ease, backdrop-filter .4s ease, padding .4s ease; }
  nav.nav.is-stuck { background-color: color-mix(in oklab, var(--page) 82%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(1.1); backdrop-filter: blur(12px) saturate(1.1);
    border-bottom-color: rgba(15, 14, 12, 0.12); padding-top: calc(16 * var(--nav-u)); padding-bottom: calc(14 * var(--nav-u)); }
  .nav__brand { font-size: max(16px, calc(25 * var(--nav-u))); font-weight: 500; }
  .nav__links { display: flex; gap: calc(63 * var(--nav-u)); font-size: max(12px, calc(16 * var(--nav-u))); font-weight: 300; letter-spacing: .02em; }
  .nav__links a { background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .4s ease; }
  .nav__links a:hover { background-size: 100% 1px; }
  /* the section being read keeps its underline (scripts/nav.ts) */
  .nav__links a.is-active { background-size: 100% 1px; font-weight: 400; }
  .nav__end { display: flex; align-items: center; gap: 12px; }
  .nav__resume { display: inline-flex; align-items: center; justify-content: center; gap: calc(12 * var(--nav-u));
    width: max(104px, calc(144 * var(--nav-u))); height: max(36px, calc(50 * var(--nav-u)));
    background: var(--grad-resume); color: var(--paper); font-size: max(14px, calc(20 * var(--nav-u))); font-weight: 400;
    transition: transform .3s ease, box-shadow .3s ease; }
  .nav__resume img { width: max(9px, calc(12 * var(--nav-u))); height: auto; }
  .nav__resume:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(45, 10, 5, .25); }

  /* the reading switch on case studies: two halves of one pill, the page you're on filled in ink */
  .readmode { display: inline-flex; padding: 3px; border: 1px solid rgba(15, 14, 12, 0.22); border-radius: 999px; background: color-mix(in oklab, var(--paper) 70%, transparent); }
  .readmode a { display: inline-flex; align-items: baseline; gap: 6px; padding: 0 14px; height: max(30px, calc(40 * var(--nav-u))); align-items: center; border-radius: 999px;
    font-size: max(13px, calc(16 * var(--nav-u))); white-space: nowrap; color: var(--ink); transition: background-color .3s ease, color .3s ease; }
  .readmode small { font-family: var(--mono); font-size: 11px; letter-spacing: .04em; color: var(--muted); transition: color .3s ease; }
  .readmode a:hover { background: rgba(15, 14, 12, 0.07); }
  .readmode a[aria-current] { background: var(--ink); color: var(--paper); }
  .readmode a[aria-current] small { color: color-mix(in oklab, var(--paper) 70%, transparent); }
  .readmode__long { display: inline; }
  @media (max-width: 1365px) { .readmode small { display: none; } }
  @media (max-width: 600px) {
    .has-read .nav__resume { display: none; }      /* the resume is still in the menu */
    .readmode__long { display: none; }
    .readmode a { padding: 0 12px; height: 32px; }
  }

  /* phones: the menu toggle, two hairlines that cross into an ✕ */
  .nav__toggle { display: none; position: relative; width: 44px; height: 44px; margin-right: -10px; padding: 0; border: 0; background: none; cursor: pointer; color: var(--ink); }
  .nav__toggle span { position: absolute; left: 11px; width: 22px; height: 1.5px; background: currentColor; border-radius: 1px;
    transition: transform .45s cubic-bezier(.65, 0, .35, 1), top .45s cubic-bezier(.65, 0, .35, 1); }
  .nav__toggle span:first-child { top: 18px; }
  .nav__toggle span:last-child { top: 25px; }
  .nav.is-open .nav__toggle span:first-child { top: 21.5px; transform: rotate(45deg); }
  .nav.is-open .nav__toggle span:last-child { top: 21.5px; transform: rotate(-45deg); }
  nav.nav.is-open { background-color: var(--page); -webkit-backdrop-filter: none; backdrop-filter: none; border-bottom-color: transparent; }

  /* the phone menu: a paper sheet under the bar, big serif links, resume at the foot */
  div.menu { position: fixed; inset: 0; z-index: 49; display: flex; flex-direction: column; justify-content: space-between;
    padding: calc(var(--nav-h) + 48px) 20px 32px; background: var(--page); animation: menu-in .5s cubic-bezier(.2, .7, .2, 1) both; }
  div.menu[hidden] { display: none; }
  @keyframes menu-in { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  .menu__links { display: flex; flex-direction: column; }
  .menu__links a { display: flex; align-items: baseline; gap: 16px; padding: 14px 0; border-bottom: 0.5px solid rgba(15, 14, 12, 0.18);
    font-family: var(--serif); font-variation-settings: 'SOFT' 0, 'WONK' 1; font-weight: 300; font-size: 44px; line-height: 1.1;
    animation: menu-link .6s cubic-bezier(.2, .7, .2, 1) both; }
  .menu__links a:nth-child(2) { animation-delay: .05s; }
  .menu__links a:nth-child(3) { animation-delay: .1s; }
  @keyframes menu-link { from { opacity: 0; transform: translateY(16px); } }
  .menu__links small { font-family: var(--mono); font-size: 12px; color: var(--accent); }
  .menu__links a.is-active { font-style: italic; color: var(--accent); }
  .menu__foot { display: flex; justify-content: space-between; align-items: flex-end; font-size: 14px; color: var(--muted); }
  .menu__foot a { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; padding: 12px 0; }
  :global(html.menu-open) { overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { div.menu, .menu__links a { animation: none; } }

  @media (max-width: 900px) {
    nav.nav { padding: 14px 20px; }
    nav.nav.is-stuck { padding: 10px 20px; }
    .nav__links { display: none; }
    .nav__toggle { display: block; }
  }
  /* tablets: the page's wider margin */
  @media (min-width: 601px) and (max-width: 900px) {
    nav.nav { padding: 16px 40px; }
    nav.nav.is-stuck { padding: 12px 40px; }
    div.menu { padding-left: 40px; padding-right: 40px; }
  }
</style>
