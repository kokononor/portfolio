---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';
import Welcome from '../components/Welcome.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;   // keeps a page (the 404) out of search results
  welcome?: boolean;   // the Welcome sheet before the page (components/Welcome.astro): the home page only
}
const { title, description, noindex = false, welcome = false } = Astro.props;
// every page's address with a trailing slash, so /work/falcon and /work/falcon/ count as one page
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(path, Astro.site);
const shareImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Suyash" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Suyash, product designer: Namaste!" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <!-- instant page turns: when a visitor hovers or starts to press a link to another page of the site, the browser
         fetches that page ahead of the click (speculation rules; browsers without them ignore this). Fetch only, not
         a full pre-render, so nothing on the next page runs or plays before it is actually opened. -->
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prefetch: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/*.pdf' } }, { not: { selector_matches: '[download], [target=_blank]' } }] }, eagerness: 'moderate' }],
    })} />
    <script is:inline>
      // the edition's ink: the colour bar in the footer reprints the site in another spot colour for the visit
      window.__inks = [
        { name: 'Sindoor' },
        { name: 'Indigo', a: '#27348b', d: '#141b4d', l: '#9aa6e8' },
        { name: 'Peacock', a: '#0a6652', d: '#053a2f', l: '#7fcdb9' },
        { name: 'Turmeric', a: '#9a5a00', d: '#5a3300', l: '#e6b565' },
      ];
      window.__ink = i => {
        const k = window.__inks[i] || {}, st = document.documentElement.style;
        [['--accent', k.a], ['--accent-deep', k.d], ['--accent-on-dark', k.l]].forEach(([p, v]) => (v ? st.setProperty(p, v) : st.removeProperty(p)));
      };
      try { window.__ink(+(sessionStorage.getItem('ink') || 0)); } catch (e) {}
      // motion is opt-in: only when scripts run and the visitor has not asked for reduced motion
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
      // the page's width without the scrollbar (100vw includes it on Windows), so layouts never run under it (--vw)
      const de = document.documentElement;
      const setVw = () => de.style.setProperty('--vw', de.clientWidth + 'px');
      setVw();
      // the scrollbar only appears once the page has content, so measure again then (and on any later size change)
      document.addEventListener('DOMContentLoaded', setVw);
      addEventListener('load', setVw);
      addEventListener('resize', setVw);
      new ResizeObserver(setVw).observe(de);
    </script>
    <script is:inline define:vars={{ welcome }}>
      // the Welcome sheet: decided here, before the first paint, so the page never flashes before it. Shown on the
      // home page when it is the first page of the visit (any page counts as visited), with motion allowed; ?welcome
      // replays it. Scripts that open the page (the greeting, the hero's entrance) wait for window.__welcomed.
      (() => {
        const de = document.documentElement;
        let seen = false;
        try { seen = !!sessionStorage.getItem('welcomed'); sessionStorage.setItem('welcomed', '1'); } catch (e) {}
        const show = welcome && de.classList.contains('js-motion') && (!seen || /[?&]welcome\b/.test(location.search));
        let done = () => {};
        window.__welcomed = show ? new Promise(r => (done = r)) : Promise.resolve();
        window.__welcomeDone = () => done();
        if (!show) return;
        de.classList.add('welcome');
        // whatever happens to the scripts, the sheet never stays up
        setTimeout(() => { done(); de.classList.remove('welcome'); }, 9000);
      })();
    </script>
  </head>
  <body>
    {welcome && <Welcome />}
    <slot />
    <BackToTop />
    <script>
      import '../scripts/motion';
      import '../scripts/lighting';
      import '../scripts/halftone';
      import '../scripts/dogear';
      import '../scripts/music';
    </script>
  </body>
</html>
