---
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;   // keeps a page (the 404) out of search results
}
const { title, description, noindex = false } = Astro.props;
// every page's address with a trailing slash, so /work/falcon and /work/falcon/ count as one page
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(path, Astro.site);
const shareImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Suyash" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Suyash, product designer: Namaste!" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <script is:inline>
      // motion is opt-in: only when scripts run and the visitor has not asked for reduced motion
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
      // the page's width without the scrollbar (100vw includes it on Windows), so layouts never run under it (--vw)
      const de = document.documentElement;
      const setVw = () => de.style.setProperty('--vw', de.clientWidth + 'px');
      setVw();
      // the scrollbar only appears once the page has content, so measure again then (and on any later size change)
      document.addEventListener('DOMContentLoaded', setVw);
      addEventListener('load', setVw);
      addEventListener('resize', setVw);
      new ResizeObserver(setVw).observe(de);
    </script>
  </head>
  <body>
    <slot />
    <BackToTop />
    <script>
      import '../scripts/motion';
      import '../scripts/lighting';
    </script>
  </body>
</html>
